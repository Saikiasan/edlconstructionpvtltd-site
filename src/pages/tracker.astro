---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="Live Project Telemetry & Milestone Tracking | EDL Construction Pvt Ltd">
  <Header activePage="tracker" />

  <section class="bg-[#0F172A] text-white py-24 px-4 sm:px-8 border-b border-slate-800 relative overflow-hidden">
    <div class="absolute inset-0 blueprint-grid-dark opacity-25 pointer-events-none"></div>
    <div class="relative z-10 max-w-7xl mx-auto text-center space-y-4">
      <span class="text-[#0369A1] bg-sky-950/70 border border-[#0369A1]/40 px-3 py-1 rounded-full text-xs font-mono uppercase font-bold tracking-widest inline-block">
        MILESTONE TELEMETRY SYSTEM
      </span>
      <h1 class="font-serif text-4xl sm:text-5xl font-bold text-white">Client Project Tracking & QA Telemetry</h1>
      <p class="text-slate-300 text-sm max-w-2xl mx-auto font-light leading-relaxed">
        Our proprietary site telemetry and milestone monitoring framework provides authorized clients with live stage-gate verification, material test results, and critical path schedules.
      </p>
    </div>
  </section>

  <section class="py-16 sm:py-20 px-4 sm:px-8 max-w-7xl mx-auto space-y-12">
    
    <!-- Client Portal Access Card -->
    <div class="bg-gradient-to-br from-white to-[#F1F5F9] rounded-3xl p-8 sm:p-12 border border-slate-200 shadow-xl space-y-8">
      <div class="flex flex-col md:flex-row justify-between md:items-center gap-6 border-b border-slate-200 pb-6">
        <div>
          <span class="text-xs font-mono uppercase tracking-wider text-[#0369A1] font-bold block mb-1">SECURE CLIENT TELEMETRY</span>
          <h2 class="font-serif text-2xl sm:text-3xl font-bold text-[#0F172A]">Project Telemetry Access Portal</h2>
          <p class="text-xs text-slate-500 font-light mt-1">Authorized developers, clients, and consultant engineers can verify active site milestones.</p>
        </div>
        <div class="inline-flex items-center px-4 py-2 rounded-full bg-emerald-50 border border-emerald-200 text-emerald-800 text-xs font-mono font-bold">
          <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse mr-2"></span> TELEMETRY SERVERS ONLINE
        </div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <div class="p-6 rounded-2xl bg-white border border-slate-200 shadow-xs space-y-3">
          <div class="h-10 w-10 rounded-xl bg-[#0369A1]/10 text-[#0369A1] flex items-center justify-center">
            <i data-lucide="camera" class="w-5 h-5"></i>
          </div>
          <h3 class="font-bold text-base text-[#0F172A]">Drone Site Surveillance</h3>
          <p class="text-xs text-slate-500 font-light leading-relaxed">
            High-resolution aerial orthomosaic mapping and 3D volumetric earthwork scans updated bi-weekly.
          </p>
        </div>

        <div class="p-6 rounded-2xl bg-white border border-slate-200 shadow-xs space-y-3">
          <div class="h-10 w-10 rounded-xl bg-[#0369A1]/10 text-[#0369A1] flex items-center justify-center">
            <i data-lucide="clipboard-check" class="w-5 h-5"></i>
          </div>
          <h3 class="font-bold text-base text-[#0F172A]">Lab QA/QC Certificates</h3>
          <p class="text-xs text-slate-500 font-light leading-relaxed">
            Instant digital access to 7-day and 28-day concrete cube compressive strength logs and mill test reports.
          </p>
        </div>

        <div class="p-6 rounded-2xl bg-white border border-slate-200 shadow-xs space-y-3">
          <div class="h-10 w-10 rounded-xl bg-[#0369A1]/10 text-[#0369A1] flex items-center justify-center">
            <i data-lucide="calendar-clock" class="w-5 h-5"></i>
          </div>
          <h3 class="font-bold text-base text-[#0F172A]">Critical Path Tracking</h3>
          <p class="text-xs text-slate-500 font-light leading-relaxed">
            Real-time Primavera / MS Project Gantt schedules highlighting handover timelines and stage completions.
          </p>
        </div>
      </div>

      <!-- Authentication Login Form Box -->
      <div class="p-6 sm:p-8 rounded-2xl bg-[#0F172A] text-white space-y-4">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
          <div>
            <h3 class="text-lg font-bold text-white">Client Site Login</h3>
            <p class="text-xs text-slate-400 font-light">Enter your issued Project UID and access credentials to view live telemetry.</p>
          </div>
          <span class="text-[11px] font-mono text-[#0369A1] bg-[#0369A1]/20 px-3 py-1 rounded-full border border-[#0369A1]/40 self-start sm:self-auto">
            256-Bit SSL Encrypted
          </span>
        </div>

        <form id="trackerLoginForm" class="grid grid-cols-1 sm:grid-cols-3 gap-3 pt-2">
          <input 
            type="text" 
            placeholder="Contract / Project UID" 
            required 
            class="p-3 rounded-xl bg-slate-900 border border-slate-700 text-xs font-mono text-white focus:outline-none focus:border-[#0369A1]" 
          />
          <input 
            type="password" 
            placeholder="Secure Passkey" 
            required 
            class="p-3 rounded-xl bg-slate-900 border border-slate-700 text-xs font-mono text-white focus:outline-none focus:border-[#0369A1]" 
          />
          <button 
            type="submit" 
            class="py-3 px-6 bg-[#EA580C] hover:bg-[#C2410C] text-white font-bold text-xs uppercase tracking-wider rounded-xl transition-all shadow-md"
          >
            Access Telemetry
          </button>
        </form>
        <p class="text-[11px] text-slate-400 font-mono">
          Need access credentials for your active contract? Contact your appointed EDL Project Director or <a href="/contact" class="text-[#0369A1] hover:underline">request assistance</a>.
        </p>
      </div>
    </div>

    <!-- Telemetry Architecture Overview -->
    <div class="bg-white rounded-3xl p-8 border border-slate-200 shadow-md space-y-6">
      <div class="text-center max-w-2xl mx-auto space-y-2">
        <span class="text-[#0369A1] text-xs font-mono uppercase font-bold tracking-widest block">TRANSPARENCY CHARTER</span>
        <h3 class="font-serif text-2xl font-bold text-[#0F172A]">Milestone Stage-Gate Protocol</h3>
        <p class="text-xs text-slate-600 font-light">Our standard 4-phase audit cycle enforced on every contracted development.</p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-4 gap-4 text-xs font-mono text-slate-700">
        <div class="p-4 rounded-xl bg-[#F1F5F9] border border-slate-200 space-y-1">
          <span class="text-slate-400 block text-[10px]">STAGE 01</span>
          <strong class="block text-sm text-[#0F172A]">Substructure Piling</strong>
          <span class="text-emerald-700 block text-[11px]">Static & Dynamic Load Tests</span>
        </div>
        <div class="p-4 rounded-xl bg-[#F1F5F9] border border-slate-200 space-y-1">
          <span class="text-slate-400 block text-[10px]">STAGE 02</span>
          <strong class="block text-sm text-[#0F172A]">Superstructure Core</strong>
          <span class="text-[#0369A1] block text-[11px]">Pre-pour QA Verification</span>
        </div>
        <div class="p-4 rounded-xl bg-[#F1F5F9] border border-slate-200 space-y-1">
          <span class="text-slate-400 block text-[10px]">STAGE 03</span>
          <strong class="block text-sm text-[#0F172A]">MEP & Envelope</strong>
          <span class="text-[#0369A1] block text-[11px]">Pressure & Acoustic Audits</span>
        </div>
        <div class="p-4 rounded-xl bg-[#F1F5F9] border border-slate-200 space-y-1">
          <span class="text-slate-400 block text-[10px]">STAGE 04</span>
          <strong class="block text-sm text-[#0F172A]">Commissioning</strong>
          <span class="text-emerald-700 block text-[11px]">Statutory Handover Certs</span>
        </div>
      </div>
    </div>

  </section>

  <Footer />

  <script is:inline>
    document.getElementById('trackerLoginForm')?.addEventListener('submit', (e) => {
      e.preventDefault();
      alert('Secure Client Telemetry portal is verifying credentials. Authorized personnel will be redirected to their project dashboard.');
    });
  </script>
</Layout>