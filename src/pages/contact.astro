---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="Contact & Project Consultation | EDL Construction Pvt Ltd">
  <Header activePage="contact" />

  <section class="bg-[#0F172A] text-white py-24 px-4 sm:px-8 border-b border-slate-800 relative overflow-hidden">
    <div class="absolute inset-0 blueprint-grid-dark opacity-25 pointer-events-none"></div>
    <div class="relative z-10 max-w-7xl mx-auto text-center space-y-4">
      <span class="text-[#0369A1] bg-sky-950/70 border border-[#0369A1]/40 px-3 py-1 rounded-full text-xs font-mono uppercase font-bold tracking-widest inline-block">
        CLIENT ENGAGEMENT DESK
      </span>
      <h1 class="font-serif text-4xl sm:text-5xl font-bold text-white">Contact & RFP Consultation</h1>
      <p class="text-slate-300 text-sm max-w-2xl mx-auto font-light leading-relaxed">
        Connect directly with our senior engineering directors and estimating teams for turnkey EPC contracting, joint ventures, and architectural consultations.
      </p>
    </div>
  </section>

  <section class="py-20 px-4 sm:px-8 max-w-7xl mx-auto grid grid-cols-1 md:grid-cols-2 gap-12 items-start">
    
    <div class="bg-white p-8 sm:p-10 rounded-3xl border border-slate-200 shadow-xl space-y-6">
      <div>
        <h3 class="font-serif text-2xl font-bold text-[#0F172A]">Initiate Project Consultation</h3>
        <p class="text-xs text-slate-500 font-light mt-1">Submit your project scope or tender requirements to connect with our technical office.</p>
      </div>

      <form id="contactForm" class="space-y-4">
        <div>
          <label class="block text-xs font-mono uppercase text-[#0F172A] mb-1 font-semibold">Full Name / Authorized Signatory</label>
          <input type="text" required placeholder="e.g. Ramesh Kumar" class="w-full p-3.5 border border-slate-300 rounded-xl text-sm focus:outline-none focus:border-[#0369A1]" />
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div>
            <label class="block text-xs font-mono uppercase text-[#0F172A] mb-1 font-semibold">Phone Number</label>
            <input type="tel" required placeholder="+91 98765 43210" class="w-full p-3.5 border border-slate-300 rounded-xl text-sm focus:outline-none focus:border-[#0369A1]" />
          </div>
          <div>
            <label class="block text-xs font-mono uppercase text-[#0F172A] mb-1 font-semibold">Corporate Email</label>
            <input type="email" required placeholder="contact@edlconstructionpvtltd.in" class="w-full p-3.5 border border-slate-300 rounded-xl text-sm focus:outline-none focus:border-[#0369A1]" />
          </div>
        </div>

        <div>
          <label class="block text-xs font-mono uppercase text-[#0F172A] mb-1 font-semibold">Construction Sector / Project Scope</label>
          <select class="w-full p-3.5 border border-slate-300 rounded-xl text-sm focus:outline-none focus:border-[#0369A1] bg-white">
            <option>Residential Superstructure & High-Rise Civil Works</option>
            <option>Commercial Tower & Business Complex Development</option>
            <option>Heavy Civil Infrastructure, Roads & Bridges</option>
            <option>Industrial Logistics, PEB Sheds & Warehousing</option>
            <option>Turnkey General Contracting & Project Management</option>
          </select>
        </div>

        <div>
          <label class="block text-xs font-mono uppercase text-[#0F172A] mb-1 font-semibold">Estimated Built-Up Area / Budget Scope</label>
          <input type="text" placeholder="e.g. 50,000 Sq. Ft. / Turnkey Civil" class="w-full p-3.5 border border-slate-300 rounded-xl text-sm focus:outline-none focus:border-[#0369A1]" />
        </div>

        <div>
          <label class="block text-xs font-mono uppercase text-[#0F172A] mb-1 font-semibold">Project Brief / Remarks</label>
          <textarea rows="3" placeholder="Provide site location, plot details, or execution requirements..." class="w-full p-3.5 border border-slate-300 rounded-xl text-sm focus:outline-none focus:border-[#0369A1]"></textarea>
        </div>

        <button type="submit" class="w-full py-4 bg-[#EA580C] hover:bg-[#C2410C] text-white font-bold text-xs uppercase tracking-wider rounded-xl transition-all shadow-md">
          Contact Now — Submit Project Inquiry
        </button>
      </form>
    </div>

    <!-- Corporate HQ Coordinates & Email Desks -->
    <div class="space-y-6 bg-[#0F172A] text-white p-8 sm:p-10 rounded-3xl border border-slate-800 shadow-2xl blueprint-grid-dark">
      <div>
        <span class="text-xs font-mono text-[#0369A1] uppercase font-bold tracking-wider block mb-1">REGISTERED OFFICE</span>
        <h3 class="font-serif text-2xl font-bold text-white">Corporate Headquarters</h3>
      </div>
      
      <address class="not-italic text-sm text-slate-300 space-y-2 font-light leading-relaxed">
        <p><strong class="text-white text-base">EDL Construction Pvt Ltd</strong></p>
        <p>EDL Tower, 14th Floor,</p>
        <p>Senapati Bapat Marg, Lower Parel,</p>
        <p>Mumbai, Maharashtra 400013</p>
      </address>

      <div class="pt-4 border-t border-slate-800 space-y-3 text-xs font-mono text-slate-300">
        <div>PRIMARY EMAIL: <a href="mailto:contact@edlconstructionpvtltd.in" class="text-[#0369A1] hover:underline font-semibold">contact@edlconstructionpvtltd.in</a></div>
        <div>CLIENT SUPPORT: <a href="mailto:support@edlconstructionpvtltd.in" class="text-[#0369A1] hover:underline font-semibold">support@edlconstructionpvtltd.in</a></div>
        <div>CAREERS DESK: <a href="mailto:careers@edlconstructionpvtltd.in" class="text-[#0369A1] hover:underline">careers@edlconstructionpvtltd.in</a></div>
        <div>OFFICIAL DOMAIN: <span class="text-slate-400">edlconstructionpvtltd.in</span></div>
        <div>OPERATING HOURS: <span class="text-slate-400">Mon - Sat: 09:00 - 19:00 IST</span></div>
      </div>

      <div class="p-4 rounded-xl bg-slate-900/90 border border-slate-800 text-xs font-mono text-slate-400 flex items-start space-x-2">
        <i data-lucide="shield-check" class="w-4 h-4 inline text-[#0369A1] flex-shrink-0 mt-0.5"></i>
        <span>All RFP documentation and technical consultations are governed under confidentiality standards.</span>
      </div>
    </div>

  </section>

  <Footer />

  <script is:inline>
    document.getElementById('contactForm')?.addEventListener('submit', (e) => {
      e.preventDefault();
      alert('Your project inquiry has been received. Our chief engineering office will contact you within 24 business hours.');
    });
  </script>
</Layout>