---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="Careers & Engineering Opportunities | EDL Construction Pvt Ltd">
  <Header activePage="careers" />

  <section class="bg-[#0F172A] text-white py-24 px-4 sm:px-8 border-b border-slate-800 relative overflow-hidden">
    <div class="absolute inset-0 blueprint-grid-dark opacity-25 pointer-events-none"></div>
    <div class="relative z-10 max-w-7xl mx-auto text-center space-y-4">
      <span class="text-[#0369A1] bg-sky-950/70 border border-[#0369A1]/40 px-3 py-1 rounded-full text-xs font-mono uppercase font-bold tracking-widest inline-block">
        CAREERS & OPPORTUNITIES
      </span>
      <h1 class="font-serif text-4xl sm:text-5xl font-bold text-white">Build Your Engineering Career With EDL</h1>
      <p class="text-slate-300 text-sm max-w-2xl mx-auto font-light leading-relaxed">
        Join our dedicated teams of civil engineers, planning specialists, MEP coordinators, and site supervisors executing quality construction projects.
      </p>
    </div>
  </section>

  <section class="py-20 px-4 sm:px-8 max-w-7xl mx-auto space-y-12">
    
    <div class="text-center max-w-2xl mx-auto space-y-2">
      <span class="text-[#0369A1] text-xs font-mono uppercase font-bold tracking-widest block">OPEN ROLES</span>
      <h2 class="font-serif text-3xl font-bold text-[#0F172A]">Current Career Openings</h2>
    </div>

    <div class="grid grid-cols-1 gap-6">
      
      <!-- Role 1 -->
      <div class="p-8 rounded-3xl bg-white border border-slate-200 shadow-md flex flex-col md:flex-row justify-between items-start md:items-center gap-6 hover:shadow-lg transition-all">
        <div class="space-y-2">
          <div class="flex items-center space-x-3">
            <span class="px-3 py-1 rounded bg-[#0369A1]/10 text-[#0369A1] font-mono text-xs font-bold border border-[#0369A1]/20">CIVIL ENGINEERING</span>
            <span class="text-xs text-slate-500 font-mono">Mumbai HQ / Site Office</span>
          </div>
          <h3 class="font-serif text-2xl font-bold text-[#0F172A]">Senior Structural Engineer</h3>
          <p class="text-xs text-slate-600 font-light leading-relaxed max-w-2xl">
            Lead structural concrete casting supervision, rebar scheduling, and quality assurance stage checks for turnkey civil projects.
          </p>
        </div>
        <a href="/contact" class="px-6 py-3 bg-[#0F172A] hover:bg-[#0369A1] text-white font-bold text-xs uppercase tracking-wider rounded-xl transition-all shadow-xs whitespace-nowrap">
          Apply Now
        </a>
      </div>

      <!-- Role 2 -->
      <div class="p-8 rounded-3xl bg-white border border-slate-200 shadow-md flex flex-col md:flex-row justify-between items-start md:items-center gap-6 hover:shadow-lg transition-all">
        <div class="space-y-2">
          <div class="flex items-center space-x-3">
            <span class="px-3 py-1 rounded bg-[#0369A1]/10 text-[#0369A1] font-mono text-xs font-bold border border-[#0369A1]/20">PROJECT EXECUTION</span>
            <span class="text-xs text-slate-500 font-mono">Site Locations / Full-Time</span>
          </div>
          <h3 class="font-serif text-2xl font-bold text-[#0F172A]">Resident Project Manager (Civil Infrastructure)</h3>
          <p class="text-xs text-slate-600 font-light leading-relaxed max-w-2xl">
            Direct day-to-day site logistics, subcontractor coordination, vendor material testing, and milestone delivery compliance.
          </p>
        </div>
        <a href="/contact" class="px-6 py-3 bg-[#0F172A] hover:bg-[#0369A1] text-white font-bold text-xs uppercase tracking-wider rounded-xl transition-all shadow-xs whitespace-nowrap">
          Apply Now
        </a>
      </div>

      <!-- Role 3 -->
      <div class="p-8 rounded-3xl bg-white border border-slate-200 shadow-md flex flex-col md:flex-row justify-between items-start md:items-center gap-6 hover:shadow-lg transition-all">
        <div class="space-y-2">
          <div class="flex items-center space-x-3">
            <span class="px-3 py-1 rounded bg-[#0369A1]/10 text-[#0369A1] font-mono text-xs font-bold border border-[#0369A1]/20">PLANNING & ESTIMATION</span>
            <span class="text-xs text-slate-500 font-mono">Mumbai Technical Office</span>
          </div>
          <h3 class="font-serif text-2xl font-bold text-[#0F172A]">Senior QS & BOQ Estimation Engineer</h3>
          <p class="text-xs text-slate-600 font-light leading-relaxed max-w-2xl">
            Prepare detailed material take-offs, item rate tender analysis, and monthly contractor billing reconciliation.
          </p>
        </div>
        <a href="/contact" class="px-6 py-3 bg-[#0F172A] hover:bg-[#0369A1] text-white font-bold text-xs uppercase tracking-wider rounded-xl transition-all shadow-xs whitespace-nowrap">
          Apply Now
        </a>
      </div>

    </div>

    <!-- Career Inquiry Box -->
    <div class="p-8 rounded-3xl bg-[#F1F5F9] border border-slate-200 text-center space-y-4 max-w-3xl mx-auto">
      <h3 class="font-serif text-xl font-bold text-[#0F172A]">Don't see an exact match?</h3>
      <p class="text-xs text-slate-600 max-w-xl mx-auto">
        We are always seeking skilled professionals across surveying, safety supervision, and MEP design. Submit your resume to our HR department at <a href="mailto:careers@edlconstructionpvtltd.in" class="text-[#0369A1] font-bold underline">careers@edlconstructionpvtltd.in</a>.
      </p>
    </div>

  </section>

  <Footer />
</Layout>