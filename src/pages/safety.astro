---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="Safety First (QHSE) & Sustainability | EDL Construction Pvt Ltd">
  <Header activePage="safety" />

  <section class="bg-[#0F172A] text-white py-24 px-4 sm:px-8 border-b border-slate-800 relative overflow-hidden">
    <div class="absolute inset-0 blueprint-grid-dark opacity-25 pointer-events-none"></div>
    <div class="relative z-10 max-w-7xl mx-auto text-center space-y-4">
      <span class="text-[#0369A1] bg-sky-950/70 border border-[#0369A1]/40 px-3 py-1 rounded-full text-xs font-mono uppercase font-bold tracking-widest inline-block">
        ZERO HARM CULTURE
      </span>
      <h1 class="font-serif text-4xl sm:text-5xl font-bold text-white">Safety, QHSE & Quality Governance</h1>
      <p class="text-slate-300 text-sm max-w-2xl mx-auto font-light leading-relaxed">
        Executing projects with an uncompromising commitment to workforce health, zero-lost-time injury (LTI) discipline, and environmental responsibility.
      </p>
    </div>
  </section>

  <section class="py-20 px-4 sm:px-8 max-w-7xl mx-auto space-y-16">
    
    <!-- Safety Metrics Ledger -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      <div class="p-8 rounded-3xl bg-white border border-slate-200 shadow-sm text-center space-y-2">
        <span class="text-4xl font-syne font-extrabold text-[#0369A1]">100%</span>
        <h3 class="font-serif text-lg font-bold text-[#0F172A]">PPE & Harness Protocol</h3>
        <p class="text-xs text-slate-500 font-light leading-relaxed">Mandatory personal protective equipment and dual-lanyard tie-off protocols for height safety.</p>
      </div>

      <div class="p-8 rounded-3xl bg-white border border-slate-200 shadow-sm text-center space-y-2">
        <span class="text-4xl font-syne font-extrabold text-[#0F172A]">0-Tolerance</span>
        <h3 class="font-serif text-lg font-bold text-[#0F172A]">Structural QA/QC Standard</h3>
        <p class="text-xs text-slate-500 font-light leading-relaxed">Multi-point stage gate inspection checkpoints before any concrete casting batch is approved.</p>
      </div>

      <div class="p-8 rounded-3xl bg-white border border-slate-200 shadow-sm text-center space-y-2">
        <span class="text-4xl font-syne font-extrabold text-emerald-600">Active</span>
        <h3 class="font-serif text-lg font-bold text-[#0F172A]">Site Health & Welfare</h3>
        <p class="text-xs text-slate-500 font-light leading-relaxed">Dedicated on-site first-aid stations, hydration zones, and emergency response plans across all jobsites.</p>
      </div>
    </div>

    <!-- 4 Pillars of QHSE -->
    <div class="space-y-6">
      <div class="text-center max-w-2xl mx-auto space-y-2">
        <span class="text-[#0369A1] text-xs font-mono uppercase font-bold tracking-widest block">CORE PROTOCOLS</span>
        <h2 class="font-serif text-3xl font-bold text-[#0F172A]">Our 4-Pillar Safety Architecture</h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        <div class="p-8 rounded-3xl bg-[#F1F5F9] border border-slate-200 space-y-3">
          <div class="flex items-center space-x-3 text-[#0369A1]">
            <i data-lucide="shield-alert" class="w-6 h-6"></i>
            <h3 class="font-serif text-xl font-bold text-[#0F172A]">Daily Toolbox Talks & Risk Assessments</h3>
          </div>
          <p class="text-xs text-slate-600 leading-relaxed font-light">
            Every shift starts with an on-site safety briefing, equipment checks, and dynamic hazard assessments before machinery operation commences.
          </p>
        </div>

        <div class="p-8 rounded-3xl bg-[#F1F5F9] border border-slate-200 space-y-3">
          <div class="flex items-center space-x-3 text-[#0369A1]">
            <i data-lucide="leaf" class="w-6 h-6"></i>
            <h3 class="font-serif text-xl font-bold text-[#0F172A]">Sustainable Sourcing & Low-Carbon Concrete</h3>
          </div>
          <p class="text-xs text-slate-600 leading-relaxed font-light">
            Responsible procurement integrating fly ash and GGBS replacement mixes to optimize concrete hydration and reduce embodied carbon.
          </p>
        </div>

        <div class="p-8 rounded-3xl bg-[#F1F5F9] border border-slate-200 space-y-3">
          <div class="flex items-center space-x-3 text-[#0369A1]">
            <i data-lucide="droplets" class="w-6 h-6"></i>
            <h3 class="font-serif text-xl font-bold text-[#0F172A]">Environmental Runoff Control & Dust Mitigation</h3>
          </div>
          <p class="text-xs text-slate-600 leading-relaxed font-light">
            Active water misting systems, wheel-wash bays, and sediment settlement tanks to protect the surrounding environment and communities.
          </p>
        </div>

        <div class="p-8 rounded-3xl bg-[#F1F5F9] border border-slate-200 space-y-3">
          <div class="flex items-center space-x-3 text-[#0369A1]">
            <i data-lucide="heart-pulse" class="w-6 h-6"></i>
            <h3 class="font-serif text-xl font-bold text-[#0F172A]">Workforce Welfare & Occupational Health</h3>
          </div>
          <p class="text-xs text-slate-600 leading-relaxed font-light">
            Clean drinking water stations, weather-sheltered rest hubs, medical checkups, and comprehensive insurance coverage for all on-site personnel.
          </p>
        </div>
      </div>
    </div>

    <!-- CTA Section -->
    <div class="text-center pt-8">
      <a href="/contact" class="inline-flex items-center px-8 py-4 bg-[#EA580C] hover:bg-[#C2410C] text-white font-bold text-xs uppercase tracking-wider rounded-xl transition-all shadow-md">
        Contact Now — Discuss Site Safety Protocols <i data-lucide="arrow-right" class="w-4 h-4 ml-2"></i>
      </a>
    </div>

  </section>

  <Footer />
</Layout>