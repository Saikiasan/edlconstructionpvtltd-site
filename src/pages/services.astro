---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="Comprehensive EPC & Engineering Services | EDL Construction Pvt Ltd">
  <Header activePage="services" />

  <section class="bg-[#0F172A] text-white py-24 px-4 sm:px-8 border-b border-slate-800 relative overflow-hidden">
    <div class="absolute inset-0 blueprint-grid-dark opacity-25 pointer-events-none"></div>
    <div class="relative z-10 max-w-7xl mx-auto text-center space-y-4">
      <span class="text-[#0369A1] bg-sky-950/70 border border-[#0369A1]/40 px-3 py-1 rounded-full text-xs font-mono uppercase font-bold tracking-widest inline-block">
        END-TO-END CAPABILITIES
      </span>
      <h1 class="font-serif text-4xl sm:text-5xl font-bold text-white">Turnkey EPC & Engineering Services</h1>
      <p class="text-slate-300 text-sm max-w-2xl mx-auto font-light leading-relaxed">
        Delivering comprehensive engineering, procurement, and construction (EPC) solutions across residential towers, commercial business complexes, and heavy infrastructure developments.
      </p>
    </div>
  </section>

  <section class="py-20 px-4 sm:px-8 max-w-7xl mx-auto space-y-16">
    
    <!-- Service 1: Turnkey EPC -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-center">
      <div class="lg:col-span-6 space-y-4">
        <span class="px-3 py-1 rounded bg-[#0369A1]/10 text-[#0369A1] border border-[#0369A1]/30 text-xs font-mono font-bold">SERVICE 01 // GENERAL CONTRACTING</span>
        <h2 class="font-serif text-3xl font-bold text-[#0F172A]">Turnkey EPC General Contracting</h2>
        <p class="text-slate-600 text-sm leading-relaxed font-light">
          Single-point responsibility encompassing architectural coordination, structural engineering, site execution, MEP installations, statutory clearances, and final commissioning.
        </p>
        <ul class="space-y-2 text-xs font-mono text-[#020617]">
          <li class="flex items-center"><i data-lucide="check" class="w-4 h-4 mr-2 text-[#0369A1]"></i> Lump-sum turnkey & item-rate contract models</li>
          <li class="flex items-center"><i data-lucide="check" class="w-4 h-4 mr-2 text-[#0369A1]"></i> ISO 9001:2015 certified material testing standards on-site</li>
          <li class="flex items-center"><i data-lucide="check" class="w-4 h-4 mr-2 text-[#0369A1]"></i> Guaranteed delivery timeline with milestone liquidated damages</li>
        </ul>
      </div>
      <div class="lg:col-span-6 rounded-3xl overflow-hidden shadow-xl border border-slate-200">
        <img src="https://images.unsplash.com/photo-1541888946425-d0fbb186156a?auto=format&fit=crop&q=80&w=1200" alt="EPC General Contracting" loading="lazy" decoding="async" class="w-full h-80 object-cover" />
      </div>
    </div>

    <!-- Service 2: Heavy Civil & Bridges -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-center">
      <div class="lg:col-span-6 order-2 lg:order-1 rounded-3xl overflow-hidden shadow-xl border border-slate-200">
        <img src="https://images.unsplash.com/photo-1513694203232-719a280e022f?auto=format&fit=crop&q=80&w=1200" alt="Heavy Infrastructure" loading="lazy" decoding="async" class="w-full h-80 object-cover" />
      </div>
      <div class="lg:col-span-6 order-1 lg:order-2 space-y-4">
        <span class="px-3 py-1 rounded bg-[#0369A1]/10 text-[#0369A1] border border-[#0369A1]/30 text-xs font-mono font-bold">SERVICE 02 // INFRASTRUCTURE</span>
        <h2 class="font-serif text-3xl font-bold text-[#0F172A]">Heavy Civil, Bridges & Flyovers</h2>
        <p class="text-slate-600 text-sm leading-relaxed font-light">
          Extradosed and cable-stayed river bridges, elevated multi-tier viaducts, transit corridors, and deep maritime piling engineered with high-performance self-compacting concrete.
        </p>
        <ul class="space-y-2 text-xs font-mono text-[#020617]">
          <li class="flex items-center"><i data-lucide="check" class="w-4 h-4 mr-2 text-[#0369A1]"></i> Seismic Zone IV / V base-isolation dampener installation</li>
          <li class="flex items-center"><i data-lucide="check" class="w-4 h-4 mr-2 text-[#0369A1]"></i> Deep diaphragm wall and hydraulic bored cast-in-situ piling</li>
          <li class="flex items-center"><i data-lucide="check" class="w-4 h-4 mr-2 text-[#0369A1]"></i> Ultrasonic & radiographic non-destructive structural audits</li>
        </ul>
      </div>
    </div>

    <!-- Service 3: High-Rise Facade & Smart MEP -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-center">
      <div class="lg:col-span-6 space-y-4">
        <span class="px-3 py-1 rounded bg-[#0369A1]/10 text-[#0369A1] border border-[#0369A1]/30 text-xs font-mono font-bold">SERVICE 03 // FACADE & MEP</span>
        <h2 class="font-serif text-3xl font-bold text-[#0F172A]">Unitized Facades & Advanced MEP/BMS</h2>
        <p class="text-slate-600 text-sm leading-relaxed font-light">
          Double-glazed Low-E unitized curtain walls, wind tunnel-tested structural glazing, high-efficiency HVAC central chiller plants, automated building management systems, and smart power distribution.
        </p>
        <ul class="space-y-2 text-xs font-mono text-[#020617]">
          <li class="flex items-center"><i data-lucide="check" class="w-4 h-4 mr-2 text-[#0369A1]"></i> Wind load resistance tested up to 2.5 kPa acoustic attenuation</li>
          <li class="flex items-center"><i data-lucide="check" class="w-4 h-4 mr-2 text-[#0369A1]"></i> Integrated KNX / BACnet IoT telemetry for real-time energy audits</li>
          <li class="flex items-center"><i data-lucide="check" class="w-4 h-4 mr-2 text-[#0369A1]"></i> Certified fire fighting & life safety suppression infrastructure</li>
        </ul>
      </div>
      <div class="lg:col-span-6 rounded-3xl overflow-hidden shadow-xl border border-slate-200">
        <img src="https://images.unsplash.com/photo-1486406146926-c627a92ad1ab?auto=format&fit=crop&q=80&w=1200" alt="Unitized Facades & MEP" loading="lazy" decoding="async" class="w-full h-80 object-cover" />
      </div>
    </div>

  </section>

  <!-- CTA Bar -->
  <section class="py-16 bg-[#0F172A] text-white border-t border-slate-800">
    <div class="max-w-7xl mx-auto px-4 sm:px-8 flex flex-col md:flex-row justify-between items-center gap-6 text-center md:text-left">
      <div>
        <h3 class="font-serif text-2xl font-bold text-white">Have an Upcoming Turnkey Project?</h3>
        <p class="text-xs text-slate-300 font-light mt-1">Consult with our chief technical director for detailed BOQ and execution modeling.</p>
      </div>
      <a href="/contact" class="px-8 py-4 bg-[#EA580C] hover:bg-[#C2410C] text-white font-bold text-xs uppercase tracking-wider rounded-xl transition-all shadow-md">
        Contact Now — Request EPC Proposal
      </a>
    </div>
  </section>

  <Footer />
</Layout>