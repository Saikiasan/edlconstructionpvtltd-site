---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="Built-Up Area & Structural Cost Estimator | EDL Construction Pvt Ltd">
  <Header activePage="calculator" />

  <section class="bg-[#0F172A] text-white py-20 px-4 sm:px-8 border-b border-slate-800 relative">
    <div class="absolute inset-0 blueprint-grid-dark opacity-25 pointer-events-none"></div>
    <div class="relative z-10 max-w-7xl mx-auto text-center space-y-4">
      <span class="text-[#0369A1] bg-sky-950/70 border border-[#0369A1]/40 px-3 py-1 rounded-full text-xs font-mono uppercase font-bold tracking-widest inline-block">
        INTERACTIVE ESTIMATION WORKBENCH
      </span>
      <h1 class="font-serif text-4xl sm:text-5xl font-bold text-white">Turnkey Cost & Area Estimator</h1>
      <p class="text-slate-300 text-sm max-w-2xl mx-auto font-light leading-relaxed">
        Calculate approximate structural, facade, and turnkey execution budgets calibrated to current Indian steel, ready-mix concrete, and MEP index rates.
      </p>
    </div>
  </section>

  <section class="py-20 px-4 sm:px-8 max-w-7xl mx-auto">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-start">
      
      <!-- Left Workbench Controls -->
      <div class="lg:col-span-7 bg-white p-8 rounded-3xl border border-slate-200 shadow-xl space-y-8">
        <div>
          <label class="block text-xs font-mono uppercase tracking-wider text-[#0F172A] mb-3 font-semibold">1. Select Project Category</label>
          <div class="grid grid-cols-3 gap-3">
            <button id="calcBtnRes" class="py-3 px-4 rounded-xl text-xs font-bold border bg-[#0F172A] text-white border-[#0F172A]">Residential</button>
            <button id="calcBtnCom" class="py-3 px-4 rounded-xl text-xs font-bold border bg-[#F1F5F9] text-[#0F172A] border-slate-200 hover:border-slate-400">Commercial</button>
            <button id="calcBtnInf" class="py-3 px-4 rounded-xl text-xs font-bold border bg-[#F1F5F9] text-[#0F172A] border-slate-200 hover:border-slate-400">Infrastructure</button>
          </div>
        </div>

        <div>
          <div class="flex justify-between items-center mb-2">
            <label class="text-xs font-mono uppercase tracking-wider text-[#0F172A] font-semibold">2. Built-Up Area (Sq. Ft.)</label>
            <span id="calcAreaVal" class="text-lg font-mono font-bold text-[#0369A1]">5,000 Sq. Ft.</span>
          </div>
          <input type="range" id="calcAreaSlider" min="1000" max="50000" step="500" value="5000" class="w-full h-2.5 bg-slate-200 rounded-lg accent-[#0369A1]">
          <div class="flex justify-between text-[11px] font-mono text-slate-400 mt-2">
            <span>1,000 Sq. Ft.</span>
            <span>25,000 Sq. Ft.</span>
            <span>50,000 Sq. Ft.</span>
          </div>
        </div>

        <div>
          <label class="block text-xs font-mono uppercase tracking-wider text-[#0F172A] mb-3 font-semibold">3. Specification Tier</label>
          <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
            <button id="tierStd" class="p-3.5 rounded-xl text-xs font-bold border bg-[#F1F5F9] text-[#0F172A] border-slate-200 text-left">Standard EPC</button>
            <button id="tierPrem" class="p-3.5 rounded-xl text-xs font-bold border bg-[#0369A1]/10 text-[#0369A1] border-[#0369A1] text-left">Premium Structural</button>
            <button id="tierUltra" class="p-3.5 rounded-xl text-xs font-bold border bg-[#F1F5F9] text-[#0F172A] border-slate-200 text-left">Heavy Commercial</button>
          </div>
        </div>
      </div>

      <!-- Right Projected BOQ Summary Card -->
      <div class="lg:col-span-5 bg-[#0F172A] text-white p-8 rounded-3xl border border-slate-800 space-y-6 shadow-2xl blueprint-grid-dark">
        <span class="text-xs font-mono uppercase tracking-widest text-[#0369A1] block mb-1 font-bold">TURNKEY INVESTMENT PROJECTION</span>
        
        <div id="calcCostResult" class="font-syne text-4xl font-extrabold text-white">
          INR 1.89 Cr - 2.17 Cr
        </div>

        <p class="text-xs text-slate-300 leading-relaxed font-light">
          Includes comprehensive structural civil engineering, performance exterior envelope, standard MEP conduit systems, and stage-gate quality audits.
        </p>

        <div class="space-y-3 pt-4 border-t border-slate-800 text-xs font-mono text-slate-300">
          <div class="flex items-center text-emerald-400">
            <i data-lucide="check-circle-2" class="w-4 h-4 mr-2"></i> Quality Assurance Stage Gate Audits
          </div>
          <div class="flex items-center text-emerald-400">
            <i data-lucide="check-circle-2" class="w-4 h-4 mr-2"></i> Milestone-Linked Transparent Handover
          </div>
          <div class="flex items-center text-emerald-400">
            <i data-lucide="check-circle-2" class="w-4 h-4 mr-2"></i> Strict Material Batch Compliance
          </div>
        </div>

        <a href="/contact" class="w-full py-4 bg-[#EA580C] hover:bg-[#C2410C] text-white font-bold text-xs uppercase tracking-wider rounded-xl transition-all shadow-lg block text-center">
          Contact Now — Request BOQ & Site Inspection
        </a>
      </div>

    </div>
  </section>

  <Footer />

  <script is:inline>
    let baseRate = 2800;
    let tierMultiplier = 1.35;

    const slider = document.getElementById('calcAreaSlider');
    const areaVal = document.getElementById('calcAreaVal');
    const costResult = document.getElementById('calcCostResult');

    function calculate() {
      if (!slider || !areaVal || !costResult) return;
      const area = parseInt(slider.value);
      areaVal.innerText = area.toLocaleString() + ' Sq. Ft.';
      const minCr = ((area * baseRate * tierMultiplier) / 10000000).toFixed(2);
      const maxCr = ((area * baseRate * (tierMultiplier * 1.15)) / 10000000).toFixed(2);
      costResult.innerText = 'INR ' + minCr + ' Cr - ' + maxCr + ' Cr';
    }

    slider?.addEventListener('input', calculate);

    document.getElementById('calcBtnRes')?.addEventListener('click', (e) => {
      baseRate = 2800;
      updateBtnGroup(['calcBtnRes', 'calcBtnCom', 'calcBtnInf'], e.target);
      calculate();
    });
    document.getElementById('calcBtnCom')?.addEventListener('click', (e) => {
      baseRate = 3400;
      updateBtnGroup(['calcBtnRes', 'calcBtnCom', 'calcBtnInf'], e.target);
      calculate();
    });
    document.getElementById('calcBtnInf')?.addEventListener('click', (e) => {
      baseRate = 4200;
      updateBtnGroup(['calcBtnRes', 'calcBtnCom', 'calcBtnInf'], e.target);
      calculate();
    });

    document.getElementById('tierStd')?.addEventListener('click', (e) => {
      tierMultiplier = 1.0;
      updateTierGroup(['tierStd', 'tierPrem', 'tierUltra'], e.target);
      calculate();
    });
    document.getElementById('tierPrem')?.addEventListener('click', (e) => {
      tierMultiplier = 1.35;
      updateTierGroup(['tierStd', 'tierPrem', 'tierUltra'], e.target);
      calculate();
    });
    document.getElementById('tierUltra')?.addEventListener('click', (e) => {
      tierMultiplier = 1.8;
      updateTierGroup(['tierStd', 'tierPrem', 'tierUltra'], e.target);
      calculate();
    });

    function updateBtnGroup(ids, target) {
      ids.forEach(id => {
        const btn = document.getElementById(id);
        if (btn) {
          btn.className = 'py-3 px-4 rounded-xl text-xs font-bold border bg-[#F1F5F9] text-[#0F172A] border-slate-200 hover:border-slate-400';
        }
      });
      target.className = 'py-3 px-4 rounded-xl text-xs font-bold border bg-[#0F172A] text-white border-[#0F172A]';
    }

    function updateTierGroup(ids, target) {
      ids.forEach(id => {
        const btn = document.getElementById(id);
        if (btn) {
          btn.className = 'p-3.5 rounded-xl text-xs font-bold border bg-[#F1F5F9] text-[#0F172A] border-slate-200 text-left';
        }
      });
      target.className = 'p-3.5 rounded-xl text-xs font-bold border bg-[#0369A1]/10 text-[#0369A1] border-[#0369A1] text-left';
    }
  </script>
</Layout>