---
import GovLayout from '../../layouts/GovLayout.astro';
---

<GovLayout title="Statutory Compliance, Quality Assurance & CVC Vigilance Matrix" activeGovPage="compliance">
  
  <!-- Sub-page Header (Light Theme) -->
  <section class="bg-white py-14 sm:py-20 border-b border-slate-200 gov-pattern-grid-light relative">
    <div class="max-w-7xl mx-auto px-4 sm:px-8 relative z-10">
      <div class="max-w-3xl space-y-4">
        <div class="inline-flex items-center space-x-2 bg-emerald-50 border border-emerald-200 rounded-full px-3 py-1 text-xs font-mono text-emerald-900 font-semibold shadow-2xs">
          <i data-lucide="shield-check" class="w-3.5 h-3.5 mr-1 text-emerald-700"></i>
          GOVERNMENT STATUTORY & QUALITY ASSURANCE PROTOCOL
        </div>
        <h1 class="text-3xl sm:text-5xl font-syne font-extrabold text-slate-900 tracking-tight">
          Statutory Compliance, Quality & Vigilance Charter
        </h1>
        <p class="text-slate-600 text-sm sm:text-base leading-relaxed font-normal">
          An uncompromising governance framework adhering to Central Vigilance Commission (CVC) integrity mandates, NABL-accredited metallurgical & concrete testing regimes, and ISO-certified EPC management systems.
        </p>
      </div>
    </div>
  </section>

  <!-- 3 Pillar Governance Grid (Light Theme) -->
  <section class="py-12 bg-slate-50 border-b border-slate-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-8">
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        
        <div class="p-6 rounded-2xl bg-white border border-slate-200 shadow-xs space-y-3">
          <div class="h-10 w-10 rounded-lg bg-emerald-50 border border-emerald-200 text-emerald-700 flex items-center justify-center">
            <i data-lucide="shield-check" class="w-5 h-5"></i>
          </div>
          <h3 class="text-slate-900 font-syne font-bold text-lg">Central Vigilance Integrity</h3>
          <p class="text-xs text-slate-600 leading-relaxed">
            Adherent to CVC guidelines for public sector procurement, transparent escrow tracking, and strict anti-corruption safeguards on all state contracts.
          </p>
          <div class="pt-2 text-[11px] font-mono text-emerald-700 font-bold">
            ✓ Annual Integrity Audit Compliance
          </div>
        </div>

        <div class="p-6 rounded-2xl bg-white border border-slate-200 shadow-xs space-y-3">
          <div class="h-10 w-10 rounded-lg bg-amber-50 border border-amber-200 text-amber-700 flex items-center justify-center">
            <i data-lucide="test-tube-2" class="w-5 h-5"></i>
          </div>
          <h3 class="text-slate-900 font-syne font-bold text-lg">NABL Testing Surveillance</h3>
          <p class="text-xs text-slate-600 leading-relaxed">
            100% on-site laboratory testing + mandatory third-party independent testing (IITs / NITs / CRRI) for core concrete, structural steel, and bitumen.
          </p>
          <div class="pt-2 text-[11px] font-mono text-amber-800 font-bold">
            ✓ ISO/IEC 17025 Test Standards
          </div>
        </div>

        <div class="p-6 rounded-2xl bg-white border border-slate-200 shadow-xs space-y-3">
          <div class="h-10 w-10 rounded-lg bg-blue-50 border border-blue-200 text-blue-700 flex items-center justify-center">
            <i data-lucide="award" class="w-5 h-5"></i>
          </div>
          <h3 class="text-slate-900 font-syne font-bold text-lg">Triple ISO Certification</h3>
          <p class="text-xs text-slate-600 leading-relaxed">
            Fully certified Integrated Management System (IMS) encompassing Quality Management, Environmental Safety, and Occupational Health.
          </p>
          <div class="pt-2 text-[11px] font-mono text-blue-900 font-bold">
            ✓ ISO 9001 • 14001 • 45001
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- 7-Tier QA/QC Framework (Light Theme) -->
  <section class="py-16 sm:py-20 bg-white border-b border-slate-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-8">
      <div class="max-w-3xl mb-12">
        <span class="text-xs font-mono uppercase tracking-wider text-amber-800 font-bold block mb-1">
          Quality Control Engineering
        </span>
        <h2 class="text-2xl sm:text-4xl font-syne font-extrabold text-slate-900">
          7-Tier Quality Surveillance Regime
        </h2>
        <p class="text-xs sm:text-sm text-slate-600 mt-2">
          From quarry source inspections to digital sensor maturity monitoring, every cubic meter of public infrastructure undergoes multi-stage verification.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4">
        
        <div class="p-5 rounded-xl bg-slate-50 border border-slate-200 space-y-2 shadow-2xs">
          <span class="font-mono text-xs text-amber-800 font-bold">STAGE 01</span>
          <h4 class="text-slate-900 font-bold text-sm">Raw Material Validation</h4>
          <p class="text-xs text-slate-600">Chemical and physical analysis of cement, aggregates, Fly Ash/GGBS, and admixtures before silo batching.</p>
        </div>

        <div class="p-5 rounded-xl bg-slate-50 border border-slate-200 space-y-2 shadow-2xs">
          <span class="font-mono text-xs text-amber-800 font-bold">STAGE 02</span>
          <h4 class="text-slate-900 font-bold text-sm">Batching Plant Telemetry</h4>
          <p class="text-xs text-slate-600">Automated moisture compensation sensors and SCADA printouts for every transit mixer batch load.</p>
        </div>

        <div class="p-5 rounded-xl bg-slate-50 border border-slate-200 space-y-2 shadow-2xs">
          <span class="font-mono text-xs text-amber-800 font-bold">STAGE 03</span>
          <h4 class="text-slate-900 font-bold text-sm">Pre-Pour Rebar Clearance</h4>
          <p class="text-xs text-slate-600">Cover block depth gauge inspections, ultrasonic weld flaw tests, and joint sign-off with Authority Engineers.</p>
        </div>

        <div class="p-5 rounded-xl bg-slate-50 border border-slate-200 space-y-2 shadow-2xs">
          <span class="font-mono text-xs text-amber-800 font-bold">STAGE 04</span>
          <h4 class="text-slate-900 font-bold text-sm">Slump & Flow Rheology</h4>
          <p class="text-xs text-slate-600">Slump cone & flow table tests per IS 1199 at the exact point of placement to guarantee workability.</p>
        </div>

        <div class="p-5 rounded-xl bg-slate-50 border border-slate-200 space-y-2 shadow-2xs">
          <span class="font-mono text-xs text-amber-800 font-bold">STAGE 05</span>
          <h4 class="text-slate-900 font-bold text-sm">Temperature & Hydration</h4>
          <p class="text-xs text-slate-600">Embedded thermocouples in mass concrete rafts (Bridges/Foundations) to avoid thermal cracking.</p>
        </div>

        <div class="p-5 rounded-xl bg-slate-50 border border-slate-200 space-y-2 shadow-2xs">
          <span class="font-mono text-xs text-amber-800 font-bold">STAGE 06</span>
          <h4 class="text-slate-900 font-bold text-sm">7, 14 & 28-Day Curing Crushing</h4>
          <p class="text-xs text-slate-600">Cube crushing on digital UTM machines with automatic video capture and encrypted results logging.</p>
        </div>

        <div class="p-5 rounded-xl bg-slate-50 border border-slate-200 space-y-2 shadow-2xs">
          <span class="font-mono text-xs text-amber-800 font-bold">STAGE 07</span>
          <h4 class="text-slate-900 font-bold text-sm">Non-Destructive Testing (NDT)</h4>
          <p class="text-xs text-slate-600">Ultrasonic Pulse Velocity (UPV), Rebound Hammer, and Core extraction validation by independent labs.</p>
        </div>

        <div class="p-5 rounded-xl bg-blue-50/70 border border-blue-200 space-y-2 flex flex-col justify-center shadow-2xs">
          <span class="font-mono text-xs text-blue-900 font-bold">AUTHORITY SIGN-OFF</span>
          <h4 class="text-slate-900 font-bold text-sm">RFI & QAP Digital Logs</h4>
          <p class="text-xs text-slate-600">100% Request for Inspection (RFI) records shared directly with Ministry Project Management Consultants.</p>
        </div>

      </div>
    </div>
  </section>

  <!-- Central Vigilance & Whistleblower Policy Section (Light Theme) -->
  <section class="py-16 bg-slate-50 border-b border-slate-200" id="cvc">
    <div class="max-w-7xl mx-auto px-4 sm:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-center">
        <div class="lg:col-span-7 space-y-4">
          <span class="text-xs font-mono text-amber-800 uppercase font-bold tracking-wider">
            Public Sector Ethics & Transparency
          </span>
          <h2 class="text-2xl sm:text-3xl font-syne font-extrabold text-slate-900">
            Central Vigilance Commission (CVC) & RTI Compliance
          </h2>
          <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">
            EDL Construction enforces zero-tolerance towards corruption, unethical procurement, or statutory bypasses. All public project accounts are subjected to concurrent audits and accessible to nodal officers.
          </p>

          <div class="p-5 rounded-xl bg-white border border-slate-200 shadow-xs space-y-2 text-xs">
            <h4 class="text-slate-900 font-semibold flex items-center">
              <i data-lucide="lock" class="w-4 h-4 text-amber-700 mr-2"></i>
              Independent Whistleblower & Vigilance Redressal Mechanism
            </h4>
            <p class="text-slate-600">
              Any stakeholder, citizen, or government official can register a confidential inquiry or report non-compliance directly to the Chief Vigilance Officer.
            </p>
            <div class="pt-2 flex flex-wrap gap-4 text-xs font-mono">
              <span class="text-slate-700">Email: <a href="mailto:vigilance@edlconstructionpvtltd.in" class="text-blue-900 font-bold hover:underline">vigilance@edlconstructionpvtltd.in</a></span>
              <span class="text-slate-700">Direct Desk: <strong class="text-slate-900">+91 (022) 6199 4010</strong></span>
            </div>
          </div>
        </div>

        <div class="lg:col-span-5 bg-white p-6 rounded-2xl border border-slate-200 shadow-sm space-y-4">
          <h4 class="text-slate-900 font-syne font-bold text-base">Key Statutory Disclosures</h4>
          
          <div class="space-y-2.5 text-xs font-mono">
            <div class="p-2.5 rounded bg-slate-50 border border-slate-200 flex justify-between">
              <span class="text-slate-500">Corporate Identity (CIN):</span>
              <strong class="text-slate-900">U45200MH2026PTC...</strong>
            </div>
            <div class="p-2.5 rounded bg-slate-50 border border-slate-200 flex justify-between">
              <span class="text-slate-500">GeM Registration ID:</span>
              <strong class="text-amber-800">GEM-EDL-IN-2026</strong>
            </div>
            <div class="p-2.5 rounded bg-slate-50 border border-slate-200 flex justify-between">
              <span class="text-slate-500">GSTIN Registration:</span>
              <strong class="text-slate-900">27AAACE1234F1Z8</strong>
            </div>
            <div class="p-2.5 rounded bg-slate-50 border border-slate-200 flex justify-between">
              <span class="text-slate-500">PF / ESIC Code:</span>
              <strong class="text-slate-900">MH/BAN/0098421</strong>
            </div>
            <div class="p-2.5 rounded bg-slate-50 border border-slate-200 flex justify-between">
              <span class="text-slate-500">ISO Certification Body:</span>
              <strong class="text-emerald-700">TUV / Bureau Veritas</strong>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

</GovLayout>
