---
import GovLayout from '../../layouts/GovLayout.astro';
---

<GovLayout title="Public Works Telemetry & Milestone Monitoring Dashboard" activeGovPage="telemetry">
  
  <!-- Sub-page Header (Light Theme) -->
  <section class="bg-white py-14 sm:py-20 border-b border-slate-200 gov-pattern-grid-light relative">
    <div class="max-w-7xl mx-auto px-4 sm:px-8 relative z-10">
      <div class="max-w-3xl space-y-4">
        <div class="inline-flex items-center space-x-2 bg-emerald-50 border border-emerald-200 rounded-full px-3 py-1 text-xs font-mono text-emerald-900 font-semibold shadow-2xs">
          <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse mr-1"></span>
          QUALITY ASSURANCE & DIGITAL AUDIT INTERFACE
        </div>
        <h1 class="text-3xl sm:text-5xl font-syne font-extrabold text-slate-900 tracking-tight">
          Public Works Telemetry & Milestone Tracker
        </h1>
        <p class="text-slate-600 text-sm sm:text-base leading-relaxed font-normal">
          An illustrative digital monitoring dashboard showcasing our automated reporting protocol for Nodal Officers, Project Management Consultants (PMC), and Quality Monitors to verify physical milestones, RFI clearances, and concrete batch telemetry.
        </p>
      </div>
    </div>
  </section>

  <!-- Live Telemetry Interface -->
  <section class="py-12 sm:py-16 bg-slate-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-8 space-y-8">
      
      <!-- Project Selector & Live Status Header (Light Theme) -->
      <div class="bg-white p-5 sm:p-6 rounded-2xl border border-slate-200 shadow-xs flex flex-col md:flex-row justify-between items-stretch md:items-center gap-4">
        <div class="flex items-center space-x-4">
          <div class="h-12 w-12 rounded-xl bg-amber-50 border border-amber-200 flex items-center justify-center text-amber-800 flex-shrink-0">
            <i data-lucide="activity" class="w-6 h-6"></i>
          </div>
          <div>
            <span class="text-[11px] font-mono text-slate-500 block uppercase font-semibold">Monitoring Active Contract</span>
            <h2 class="text-slate-900 font-syne font-bold text-lg sm:text-xl" id="activeProjectTitle">
              Regional River Bridge Viaduct (Package I)
            </h2>
          </div>
        </div>

        <!-- Project Switcher Select -->
        <div class="flex items-center space-x-3">
          <label class="text-xs font-mono text-slate-600 hidden sm:inline-block font-semibold">Select Project:</label>
          <select id="telemetryProjectSelect" class="bg-slate-50 text-slate-900 text-xs font-mono px-4 py-2.5 rounded-lg border border-slate-300 focus:border-blue-600 focus:bg-white focus:outline-none">
            <option value="brahmaputra">Regional River Bridge Viaduct (Package I)</option>
            <option value="expressway">Access-Controlled Highway Corridor (Pkg IV)</option>
            <option value="metro">Elevated Mass Transit Viaduct & Stations</option>
            <option value="secretariat">Integrated Administrative Complex</option>
          </select>
        </div>
      </div>

      <!-- Main Telemetry Grid -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">
        
        <!-- Left 8-Cols: Core Gauges & Progress Curves -->
        <div class="lg:col-span-8 space-y-6">
          
          <!-- Key Metric Gauges (Light Theme) -->
          <div class="grid grid-cols-2 sm:grid-cols-4 gap-4">
            <div class="bg-white p-4 rounded-xl border border-slate-200 shadow-2xs">
              <span class="text-[10px] font-mono text-slate-500 block uppercase font-semibold">Physical Progress</span>
              <span class="text-2xl font-syne font-bold text-emerald-700" id="metricPhysical">78.4%</span>
              <span class="text-[10px] text-slate-500 block mt-0.5">Target: 76.0% (Ahead)</span>
            </div>
            <div class="bg-white p-4 rounded-xl border border-slate-200 shadow-2xs">
              <span class="text-[10px] font-mono text-slate-500 block uppercase font-semibold">Financial Billing</span>
              <span class="text-2xl font-syne font-bold text-amber-800" id="metricFinancial">74.2%</span>
              <span class="text-[10px] text-slate-500 block mt-0.5">₹ 1,573 Cr Disbursed</span>
            </div>
            <div class="bg-white p-4 rounded-xl border border-slate-200 shadow-2xs">
              <span class="text-[10px] font-mono text-slate-500 block uppercase font-semibold">RFIs Cleared</span>
              <span class="text-2xl font-syne font-bold text-slate-900" id="metricRFI">1,482 / 1,490</span>
              <span class="text-[10px] text-emerald-700 block mt-0.5 font-semibold">99.4% Pass Rate</span>
            </div>
            <div class="bg-white p-4 rounded-xl border border-slate-200 shadow-2xs">
              <span class="text-[10px] font-mono text-slate-500 block uppercase font-semibold">Site Safe Hours</span>
              <span class="text-2xl font-syne font-bold text-slate-900" id="metricHours">3.85M</span>
              <span class="text-[10px] text-emerald-700 block mt-0.5 font-semibold">Zero LTI Recorded</span>
            </div>
          </div>

          <!-- Interactive Milestone Breakdown (Light Theme) -->
          <div class="bg-white p-6 rounded-xl border border-slate-200 shadow-xs space-y-4">
            <div class="flex justify-between items-center border-b border-slate-100 pb-3">
              <h3 class="text-slate-900 font-syne font-bold text-base">Key Sub-Structure & Superstructure Milestones</h3>
              <span class="text-xs font-mono text-amber-800 font-bold">Milestone Stage 4 of 5</span>
            </div>

            <div class="space-y-4 text-xs font-mono" id="milestonesList">
              <div>
                <div class="flex justify-between text-slate-700 mb-1">
                  <span>Deep Caisson Well Foundations (45m Depth)</span>
                  <span class="text-emerald-700 font-bold">45 of 45 Sunk (100%)</span>
                </div>
                <div class="w-full bg-slate-100 rounded-full h-2 border border-slate-200">
                  <div class="bg-emerald-600 h-2 rounded-full w-full"></div>
                </div>
              </div>

              <div>
                <div class="flex justify-between text-slate-700 mb-1">
                  <span>Pier Shafts & Pier Caps (M60 Grade)</span>
                  <span class="text-emerald-700 font-bold">42 of 45 Completed (93.3%)</span>
                </div>
                <div class="w-full bg-slate-100 rounded-full h-2 border border-slate-200">
                  <div class="bg-emerald-600 h-2 rounded-full" style="width: 93.3%;"></div>
                </div>
              </div>

              <div>
                <div class="flex justify-between text-slate-700 mb-1">
                  <span>Extradosed Superstructure Spans Erection</span>
                  <span class="text-amber-800 font-bold">12 of 16 Spans (75.0%)</span>
                </div>
                <div class="w-full bg-slate-100 rounded-full h-2 border border-slate-200">
                  <div class="bg-amber-600 h-2 rounded-full" style="width: 75%;"></div>
                </div>
              </div>

              <div>
                <div class="flex justify-between text-slate-700 mb-1">
                  <span>Stay Cable Tensioning & Wax Injection</span>
                  <span class="text-slate-800 font-bold">48 of 80 Cables (60.0%)</span>
                </div>
                <div class="w-full bg-slate-100 rounded-full h-2 border border-slate-200">
                  <div class="bg-blue-700 h-2 rounded-full" style="width: 60%;"></div>
                </div>
              </div>
            </div>
          </div>

          <!-- Live Material Quality Cube Strength Log (Light Theme) -->
          <div class="bg-white p-6 rounded-xl border border-slate-200 shadow-xs space-y-3">
            <h3 class="text-slate-900 font-syne font-bold text-base flex items-center">
              <i data-lucide="test-tube" class="w-4 h-4 text-amber-700 mr-2"></i>
              Recent 28-Day Concrete Cube Compressive Strength Log (NABL Verified)
            </h3>
            
            <div class="overflow-x-auto">
              <table class="w-full text-left text-xs font-mono">
                <thead>
                  <tr class="text-slate-500 border-b border-slate-200 bg-slate-50">
                    <th class="py-2.5 px-3">Sample ID</th>
                    <th class="py-2.5 px-3">Structure Element</th>
                    <th class="py-2.5 px-3">Specified Grade</th>
                    <th class="py-2.5 px-3">28-Day Strength</th>
                    <th class="py-2.5 px-3">Status</th>
                  </tr>
                </thead>
                <tbody class="divide-y divide-slate-100 text-slate-700">
                  <tr>
                    <td class="py-2.5 px-3 font-bold text-blue-900">EDL-CUBE-8921</td>
                    <td class="py-2.5 px-3">Pier P-14 Pier Cap (Pour 2)</td>
                    <td class="py-2.5 px-3">M70 SCC</td>
                    <td class="py-2.5 px-3 text-emerald-700 font-bold">76.8 MPa</td>
                    <td class="py-2.5 px-3"><span class="px-2 py-0.5 bg-emerald-50 text-emerald-800 border border-emerald-200 rounded font-bold">PASSED</span></td>
                  </tr>
                  <tr>
                    <td class="py-2.5 px-3 font-bold text-blue-900">EDL-CUBE-8920</td>
                    <td class="py-2.5 px-3">Well Cap W-08 (Mass Concrete)</td>
                    <td class="py-2.5 px-3">M60 GGBS</td>
                    <td class="py-2.5 px-3 text-emerald-700 font-bold">66.2 MPa</td>
                    <td class="py-2.5 px-3"><span class="px-2 py-0.5 bg-emerald-50 text-emerald-800 border border-emerald-200 rounded font-bold">PASSED</span></td>
                  </tr>
                  <tr>
                    <td class="py-2.5 px-3 font-bold text-blue-900">EDL-CUBE-8919</td>
                    <td class="py-2.5 px-3">Segment S-11 Cantilever Deck</td>
                    <td class="py-2.5 px-3">M70 SCC</td>
                    <td class="py-2.5 px-3 text-emerald-700 font-bold">78.1 MPa</td>
                    <td class="py-2.5 px-3"><span class="px-2 py-0.5 bg-emerald-50 text-emerald-800 border border-emerald-200 rounded font-bold">PASSED</span></td>
                  </tr>
                </tbody>
              </table>
            </div>
          </div>

        </div>

        <!-- Right 4-Cols: Drone Survey & Authority Sign-off Panel -->
        <div class="lg:col-span-4 space-y-6">
          
          <!-- Drone Telemetry Card (Light Theme) -->
          <div class="bg-white p-5 rounded-xl border border-slate-200 shadow-xs space-y-3">
            <div class="flex items-center justify-between">
              <span class="text-xs font-mono text-amber-800 font-bold flex items-center">
                <i data-lucide="video" class="w-3.5 h-3.5 mr-1.5 text-amber-700"></i> Drone Survey Feed
              </span>
              <span class="text-[10px] font-mono bg-slate-100 text-slate-700 font-semibold px-2 py-0.5 rounded border border-slate-200">
                Cycle #42
              </span>
            </div>

            <div class="relative h-44 rounded-lg overflow-hidden bg-slate-100 border border-slate-200">
              <img src="/frames/frame_0001.jpg" alt="Drone Survey Aerial" class="w-full h-full object-cover" />
              <div class="absolute inset-0 bg-slate-900/40 flex items-center justify-center">
                <span class="px-3 py-1.5 rounded-lg bg-white/95 text-slate-900 text-xs font-mono border border-slate-200 shadow-xs flex items-center font-semibold">
                  <i data-lucide="crosshair" class="w-3.5 h-3.5 mr-1.5 text-emerald-600"></i>
                  Geo-Tagged LiDAR Verified
                </span>
              </div>
            </div>

            <div class="text-[11px] font-mono text-slate-600 space-y-1.5 pt-1">
              <div class="flex justify-between">
                <span>Flight Date:</span>
                <span class="text-slate-900 font-semibold">24 Aug 2026</span>
              </div>
              <div class="flex justify-between">
                <span>Coordinates:</span>
                <span class="text-slate-900">26.1844° N, 91.7458° E</span>
              </div>
              <div class="flex justify-between">
                <span>Elevation Deviation:</span>
                <span class="text-emerald-700 font-bold">± 2.5mm (Within Spec)</span>
              </div>
            </div>
          </div>

          <!-- Authority Inspection & PMC Clearance Status (Light Theme) -->
          <div class="bg-white p-5 rounded-xl border border-slate-200 shadow-xs space-y-3">
            <h4 class="text-slate-900 font-syne font-bold text-sm">Authority Engineer Joint Clearances</h4>
            
            <div class="space-y-2.5 text-xs font-mono">
              <div class="p-3 rounded-lg bg-slate-50 border border-slate-200 flex items-center justify-between">
                <div>
                  <span class="text-slate-900 block font-semibold">Monthly Stage Billing #18</span>
                  <span class="text-slate-500 text-[10px]">Verified by PMC Lead</span>
                </div>
                <span class="text-emerald-700 font-bold bg-emerald-50 px-2 py-0.5 rounded border border-emerald-200">APPROVED</span>
              </div>

              <div class="p-3 rounded-lg bg-slate-50 border border-slate-200 flex items-center justify-between">
                <div>
                  <span class="text-slate-900 block font-semibold">Quality Surveillance Audit Q2</span>
                  <span class="text-slate-500 text-[10px]">Independent Nodal Team</span>
                </div>
                <span class="text-emerald-700 font-bold bg-emerald-50 px-2 py-0.5 rounded border border-emerald-200">COMPLIANT</span>
              </div>

              <div class="p-3 rounded-lg bg-slate-50 border border-slate-200 flex items-center justify-between">
                <div>
                  <span class="text-slate-900 block font-semibold">Environmental & Forest NOC</span>
                  <span class="text-slate-500 text-[10px]">MoEFCC Surveillance</span>
                </div>
                <span class="text-emerald-700 font-bold bg-emerald-50 px-2 py-0.5 rounded border border-emerald-200">VALID</span>
              </div>
            </div>

            <div class="pt-2">
              <a href="/gov/liaison" class="w-full py-2.5 bg-slate-900 hover:bg-slate-800 text-white text-xs font-mono font-bold rounded-lg text-center block transition-colors shadow-2xs">
                Request Joint Site Inspection
              </a>
            </div>
          </div>

        </div>

      </div>

    </div>
  </section>

</GovLayout>

<script is:inline>
  const projectSelect = document.getElementById('telemetryProjectSelect');
  const projectTitle = document.getElementById('activeProjectTitle');
  const metricPhysical = document.getElementById('metricPhysical');
  const metricFinancial = document.getElementById('metricFinancial');
  const metricRFI = document.getElementById('metricRFI');

  const projectData = {
    brahmaputra: {
      title: "Regional River Bridge Viaduct (Package I)",
      physical: "78.4%",
      financial: "74.2%",
      rfi: "1,482 / 1,490"
    },
    expressway: {
      title: "Access-Controlled Highway Corridor (Pkg IV)",
      physical: "100.0%",
      financial: "100.0%",
      rfi: "2,840 / 2,840"
    },
    metro: {
      title: "Elevated Mass Transit Viaduct & Stations",
      physical: "64.2%",
      financial: "61.0%",
      rfi: "980 / 992"
    },
    secretariat: {
      title: "Integrated Administrative Complex",
      physical: "92.0%",
      financial: "89.5%",
      rfi: "1,210 / 1,215"
    }
  };

  projectSelect?.addEventListener('change', (e) => {
    const selected = projectData[e.target.value];
    if (selected) {
      if (projectTitle) projectTitle.innerText = selected.title;
      if (metricPhysical) metricPhysical.innerText = selected.physical;
      if (metricFinancial) metricFinancial.innerText = selected.financial;
      if (metricRFI) metricRFI.innerText = selected.rfi;
    }
  });
</script>
