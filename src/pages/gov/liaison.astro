---
import GovLayout from '../../layouts/GovLayout.astro';
---

<GovLayout title="Government Liaison, Nodal Desk & Rapid Response Cell" activeGovPage="liaison">
  
  <!-- Sub-page Header (Light Theme) -->
  <section class="bg-white py-14 sm:py-20 border-b border-slate-200 gov-pattern-grid-light relative">
    <div class="max-w-7xl mx-auto px-4 sm:px-8 relative z-10">
      <div class="max-w-3xl space-y-4">
        <div class="inline-flex items-center space-x-2 bg-amber-50 border border-amber-200 rounded-full px-3 py-1 text-xs font-mono text-amber-900 font-semibold shadow-2xs">
          <i data-lucide="user-check" class="w-3.5 h-3.5 mr-1 text-amber-700"></i>
          OFFICIAL GOVERNMENT PROTOCOL & LIAISON GATEWAY
        </div>
        <h1 class="text-3xl sm:text-5xl font-syne font-extrabold text-slate-900 tracking-tight">
          Government Liaison & Nodal Officer Protocol Desk
        </h1>
        <p class="text-slate-600 text-sm sm:text-base leading-relaxed font-normal">
          A high-priority institutional channel dedicated to Union Ministries, State PWD Principal Secretaries, Municipal Commissioners, and Chief Engineers for formal technical briefings, site inspections, and emergency infrastructure restoration.
        </p>
      </div>
    </div>
  </section>

  <!-- Nodal Directory Grid (Light Theme) -->
  <section class="py-14 sm:py-18 bg-slate-50 border-b border-slate-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-8">
      
      <div class="max-w-3xl mb-10">
        <span class="text-xs font-mono uppercase tracking-wider text-amber-800 font-bold block mb-1">
          Authorized Liaison Hierarchy
        </span>
        <h2 class="text-2xl sm:text-3xl font-syne font-extrabold text-slate-900">
          Key Institutional Representatives
        </h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        
        <!-- Officer 1 -->
        <div class="bg-white p-6 rounded-2xl border border-slate-200 shadow-xs space-y-4">
          <div class="flex items-center space-x-3.5">
            <div class="h-12 w-12 rounded-xl bg-amber-50 border border-amber-200 flex items-center justify-center text-amber-800">
              <i data-lucide="user" class="w-6 h-6"></i>
            </div>
            <div>
              <h3 class="text-slate-900 font-syne font-bold text-base">Executive Director (EPC)</h3>
              <p class="text-xs font-mono text-amber-800 font-bold">Chief Technical Liaison</p>
            </div>
          </div>
          <p class="text-xs text-slate-600 leading-relaxed">
            Primary point of contact for public departments, municipal authorities, and infrastructure stakeholders for project scope consultations and tender briefings.
          </p>
          <div class="pt-3 border-t border-slate-100 text-xs font-mono text-slate-600 space-y-1.5">
            <div class="flex items-center">
              <i data-lucide="mail" class="w-3.5 h-3.5 mr-2 text-slate-400"></i>
              <a href="mailto:contact@edlconstructionpvtltd.in" class="hover:text-blue-900 text-slate-800 font-medium">contact@edlconstructionpvtltd.in</a>
            </div>
            <div class="flex items-center">
              <i data-lucide="phone" class="w-3.5 h-3.5 mr-2 text-slate-400"></i>
              <a href="tel:8822494773" class="hover:text-blue-900 text-slate-800 font-semibold">+91 8822494773</a>
            </div>
          </div>
        </div>

        <!-- Officer 2 -->
        <div class="bg-white p-6 rounded-2xl border border-slate-200 shadow-xs space-y-4">
          <div class="flex items-center space-x-3.5">
            <div class="h-12 w-12 rounded-xl bg-emerald-50 border border-emerald-200 flex items-center justify-center text-emerald-700">
              <i data-lucide="shield-check" class="w-6 h-6"></i>
            </div>
            <div>
              <h3 class="text-slate-900 font-syne font-bold text-base">Quality Assurance & Standards</h3>
              <p class="text-xs font-mono text-emerald-800 font-bold">Compliance & Materials</p>
            </div>
          </div>
          <p class="text-xs text-slate-600 leading-relaxed">
            Responsible for material test certifications, cube compression logs, site quality audit documentation, and statutory code compliance.
          </p>
          <div class="pt-3 border-t border-slate-100 text-xs font-mono text-slate-600 space-y-1.5">
            <div class="flex items-center">
              <i data-lucide="mail" class="w-3.5 h-3.5 mr-2 text-slate-400"></i>
              <a href="mailto:support@edlconstructionpvtltd.in" class="hover:text-blue-900 text-slate-800 font-medium">support@edlconstructionpvtltd.in</a>
            </div>
            <div class="flex items-center">
              <i data-lucide="phone" class="w-3.5 h-3.5 mr-2 text-slate-400"></i>
              <a href="tel:8822494773" class="hover:text-blue-900 text-slate-800 font-semibold">+91 8822494773</a>
            </div>
          </div>
        </div>

        <!-- Officer 3 -->
        <div class="bg-white p-6 rounded-2xl border border-slate-200 shadow-xs space-y-4">
          <div class="flex items-center space-x-3.5">
            <div class="h-12 w-12 rounded-xl bg-blue-50 border border-blue-200 flex items-center justify-center text-blue-800">
              <i data-lucide="hard-hat" class="w-6 h-6"></i>
            </div>
            <div>
              <h3 class="text-slate-900 font-syne font-bold text-base">Project Operations Team</h3>
              <p class="text-xs font-mono text-blue-800 font-bold">Field Execution Cell</p>
            </div>
          </div>
          <p class="text-xs text-slate-600 leading-relaxed">
            Direct operational unit coordinating site mobilization, heavy machinery deployment, vendor logistics, and emergency civil restorations.
          </p>
          <div class="pt-3 border-t border-slate-100 text-xs font-mono text-slate-600 space-y-1.5">
            <div class="flex items-center">
              <i data-lucide="mail" class="w-3.5 h-3.5 mr-2 text-slate-400"></i>
              <a href="mailto:contact@edlconstructionpvtltd.in" class="hover:text-blue-900 text-slate-800 font-medium">contact@edlconstructionpvtltd.in</a>
            </div>
            <div class="flex items-center">
              <i data-lucide="phone" class="w-3.5 h-3.5 mr-2 text-slate-400"></i>
              <a href="tel:8822494773" class="hover:text-blue-900 text-slate-800 font-semibold">+91 8822494773</a>
            </div>
          </div>
        </div>

      </div>

    </div>
  </section>

  <!-- Interactive Nodal Protocol Request Form (Light Theme) -->
  <section class="py-16 bg-white border-b border-slate-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
        
        <div class="lg:col-span-5 space-y-4">
          <span class="text-xs font-mono text-amber-800 uppercase font-bold tracking-wider">
            Official Ministry Channel
          </span>
          <h2 class="text-2xl sm:text-4xl font-syne font-extrabold text-slate-900">
            Schedule a Technical Presentation or Site Inspection
          </h2>
          <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">
            Government authorities and nodal engineers can request formal EPC presentations, tender pre-bid clarifications, or schedule authorized joint inspection visits to ongoing infrastructure sites.
          </p>

          <div class="p-4 rounded-xl bg-slate-50 border border-slate-200 text-xs font-mono text-slate-700 space-y-2">
            <div class="flex items-center text-amber-800 font-bold">
              <i data-lucide="shield-check" class="w-4 h-4 mr-2 text-emerald-600"></i>
              Protocol Adherence Guaranteed
            </div>
            <p class="text-slate-600">
              All interactions are logged in compliance with government liaison norms and institutional recordkeeping standards.
            </p>
          </div>
        </div>

        <div class="lg:col-span-7">
          <div class="bg-white rounded-2xl p-6 sm:p-8 border border-slate-200 shadow-md space-y-4">
            <h3 class="text-lg font-syne font-bold text-slate-900">Official Infrastructure Inquiry Dispatch</h3>

            <form class="space-y-3.5" onsubmit="event.preventDefault(); alert('Requisition received! Our chief technical director will coordinate with your office within 24 business hours.');">
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                <div>
                  <label class="block text-xs font-mono text-slate-700 mb-1">Official Name & Designation *</label>
                  <input type="text" required placeholder="e.g. Chief Engineer / Project Director" class="w-full bg-slate-50 text-slate-900 text-xs px-3.5 py-2.5 rounded-lg border border-slate-300 focus:border-blue-600 focus:bg-white focus:outline-none" />
                </div>
                <div>
                  <label class="block text-xs font-mono text-slate-700 mb-1">Department / Organization *</label>
                  <input type="text" required placeholder="e.g. State PWD / Urban Authority" class="w-full bg-slate-50 text-slate-900 text-xs px-3.5 py-2.5 rounded-lg border border-slate-300 focus:border-blue-600 focus:bg-white focus:outline-none" />
                </div>
              </div>

              <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                <div>
                  <label class="block text-xs font-mono text-slate-700 mb-1">Official Email *</label>
                  <input type="email" required placeholder="official@dept.gov.in" class="w-full bg-slate-50 text-slate-900 text-xs px-3.5 py-2.5 rounded-lg border border-slate-300 focus:border-blue-600 focus:bg-white focus:outline-none font-mono" />
                </div>
                <div>
                  <label class="block text-xs font-mono text-slate-700 mb-1">Official Phone Number *</label>
                  <input type="tel" required placeholder="+91 98765 43210" class="w-full bg-slate-50 text-slate-900 text-xs px-3.5 py-2.5 rounded-lg border border-slate-300 focus:border-blue-600 focus:bg-white focus:outline-none font-mono" />
                </div>
              </div>

              <div>
                <label class="block text-xs font-mono text-slate-700 mb-1">Purpose of Official Interaction</label>
                <select class="w-full bg-slate-50 text-slate-900 text-xs px-3.5 py-2.5 rounded-lg border border-slate-300 focus:border-blue-600 focus:bg-white focus:outline-none">
                  <option>Request for Technical EPC Presentation / Capability Briefing</option>
                  <option>Pre-Bid Clarification Session for Active Tender</option>
                  <option>Joint Site Inspection Booking (Ongoing Projects)</option>
                  <option>Quality Assurance & NABL Test Record Verification</option>
                  <option>Emergency Disaster Infrastructure Rapid Support</option>
                  <option>General Public Sector Correspondence</option>
                </select>
              </div>

              <div>
                <label class="block text-xs font-mono text-slate-700 mb-1">Official Query / Requisition Details</label>
                <textarea rows="3" placeholder="Provide details regarding project reference, tender number, proposed meeting dates, or inspection parameters..." class="w-full bg-slate-50 text-slate-900 text-xs px-3.5 py-2.5 rounded-lg border border-slate-300 focus:border-blue-600 focus:bg-white focus:outline-none"></textarea>
              </div>

              <button type="submit" class="w-full py-3 bg-slate-900 hover:bg-slate-800 text-white font-bold text-xs rounded-lg transition-all shadow-xs flex items-center justify-center font-mono">
                <i data-lucide="send" class="w-4 h-4 mr-2 text-amber-400"></i>
                Transmit Official Protocol Requisition
              </button>
            </form>
          </div>
        </div>

      </div>
    </div>
  </section>

</GovLayout>
