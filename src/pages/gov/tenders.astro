---
import GovLayout from '../../layouts/GovLayout.astro';
import TenderBoard from '../../components/gov/TenderBoard.astro';
---

<GovLayout title="Active E-Tenders, Procurement & EOI Portal" activeGovPage="tenders">
  
  <!-- Sub-page Header (Light Theme) -->
  <section class="bg-white py-14 sm:py-20 border-b border-slate-200 gov-pattern-grid-light relative">
    <div class="max-w-7xl mx-auto px-4 sm:px-8 relative z-10">
      <div class="max-w-3xl space-y-4">
        <div class="inline-flex items-center space-x-2 bg-amber-50 border border-amber-200 rounded-full px-3 py-1 text-xs font-mono text-amber-900 font-semibold shadow-2xs">
          <i data-lucide="file-text" class="w-3.5 h-3.5 mr-1 text-amber-700"></i>
          CENTRAL PUBLIC PROCUREMENT & E-TENDERING DESK
        </div>
        <h1 class="text-3xl sm:text-5xl font-syne font-extrabold text-slate-900 tracking-tight">
          Active E-Tenders, RFPs & Expression of Interest
        </h1>
        <p class="text-slate-600 text-sm sm:text-base leading-relaxed font-normal">
          Access official Notice Inviting Tenders (NIT), tender specifications, Bill of Quantities (BOQ), corrigenda logs, and submit pre-qualification Expressions of Interest (EOI) for joint ventures and specialized subcontract packages.
        </p>
      </div>
    </div>
  </section>

  <!-- Tender Board Section -->
  <section class="py-12 sm:py-16 bg-slate-50 border-b border-slate-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-8">
      
      <!-- Stats Row (Light Theme) -->
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 mb-8">
        <div class="p-4 rounded-xl bg-white border border-slate-200 shadow-2xs">
          <span class="text-slate-500 text-xs font-mono block mb-1">Active Notices</span>
          <span class="text-2xl font-syne font-bold text-slate-900">4 Live RFPs</span>
        </div>
        <div class="p-4 rounded-xl bg-white border border-slate-200 shadow-2xs">
          <span class="text-slate-500 text-xs font-mono block mb-1">Cumulative Value</span>
          <span class="text-2xl font-syne font-bold text-amber-800">₹ 4,605.5 Cr</span>
        </div>
        <div class="p-4 rounded-xl bg-white border border-slate-200 shadow-2xs">
          <span class="text-slate-500 text-xs font-mono block mb-1">JV Opportunity</span>
          <span class="text-2xl font-syne font-bold text-emerald-700">Open for MSMEs</span>
        </div>
        <div class="p-4 rounded-xl bg-white border border-slate-200 shadow-2xs">
          <span class="text-slate-500 text-xs font-mono block mb-1">CVC Transparency</span>
          <span class="text-2xl font-syne font-bold text-blue-900">100% E-Bidding</span>
        </div>
      </div>

      <TenderBoard />
    </div>
  </section>

  <!-- Joint Venture & Subcontractor Prequalification Criteria -->
  <section class="py-16 bg-white border-b border-slate-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
        <div class="lg:col-span-6 space-y-4">
          <span class="text-xs font-mono text-amber-800 uppercase font-bold tracking-wider">
            Consortium & Vendor Ecosystem
          </span>
          <h2 class="text-2xl sm:text-4xl font-syne font-extrabold text-slate-900 tracking-tight">
            Prequalification for Joint Ventures & MSME Subcontractors
          </h2>
          <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">
            EDL Construction actively partners with qualified MSMEs, specialized piling contractors, structural steel fabricators, and geotechnical testing firms for public sector EPC packages.
          </p>

          <div class="space-y-3 pt-2">
            <div class="flex items-start p-3.5 rounded-xl bg-slate-50 border border-slate-200 text-xs">
              <i data-lucide="check-circle-2" class="w-4 h-4 text-emerald-600 mr-2.5 mt-0.5 flex-shrink-0"></i>
              <div>
                <strong class="text-slate-900">Statutory & GST Compliance:</strong>
                <p class="text-slate-600">Valid GSTIN, PAN, PF/ESIC registration, and minimum 3 years of audited financials.</p>
              </div>
            </div>

            <div class="flex items-start p-3.5 rounded-xl bg-slate-50 border border-slate-200 text-xs">
              <i data-lucide="check-circle-2" class="w-4 h-4 text-emerald-600 mr-2.5 mt-0.5 flex-shrink-0"></i>
              <div>
                <strong class="text-slate-900">Safety & Zero-LTI Record:</strong>
                <p class="text-slate-600">Commitment to EDL 100% PPE adherence, tool-box safety briefings, and certified equipment operators.</p>
              </div>
            </div>

            <div class="flex items-start p-3.5 rounded-xl bg-slate-50 border border-slate-200 text-xs">
              <i data-lucide="check-circle-2" class="w-4 h-4 text-emerald-600 mr-2.5 mt-0.5 flex-shrink-0"></i>
              <div>
                <strong class="text-slate-900">Technical Machinery Ownership:</strong>
                <p class="text-slate-600">Ownership or leasehold proof of batching plants, transit mixers, mobile cranes, or piling rigs.</p>
              </div>
            </div>
          </div>
        </div>

        <!-- Right Side: EOI Application Form (Light Theme) -->
        <div class="lg:col-span-6" id="submit-eoi">
          <div class="bg-white rounded-2xl p-6 sm:p-8 border border-slate-200 shadow-md space-y-4">
            <div>
              <span class="text-xs font-mono text-amber-800 uppercase font-bold">Official Digital Submission</span>
              <h3 class="text-xl font-syne font-bold text-slate-900">Submit Expression of Interest (EOI)</h3>
              <p class="text-xs text-slate-500">All submissions are logged with the Central Procurement Committee.</p>
            </div>

            <form class="space-y-3.5" onsubmit="event.preventDefault(); alert('EOI submitted successfully! Reference Ticket: EOI-2026-' + Math.floor(1000 + Math.random()*9000));">
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                <div>
                  <label class="block text-xs font-mono text-slate-700 mb-1">Company / Firm Name *</label>
                  <input type="text" required placeholder="e.g. Apex Infra Structures LLP" class="w-full bg-slate-50 text-slate-900 text-xs px-3.5 py-2.5 rounded-lg border border-slate-300 focus:border-blue-600 focus:bg-white focus:outline-none" />
                </div>
                <div>
                  <label class="block text-xs font-mono text-slate-700 mb-1">GSTIN / GeM ID *</label>
                  <input type="text" required placeholder="27ABCDE1234F1Z5" class="w-full bg-slate-50 text-slate-900 text-xs px-3.5 py-2.5 rounded-lg border border-slate-300 focus:border-blue-600 focus:bg-white focus:outline-none font-mono" />
                </div>
              </div>

              <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                <div>
                  <label class="block text-xs font-mono text-slate-700 mb-1">Official Email *</label>
                  <input type="email" required placeholder="tenders@yourfirm.com" class="w-full bg-slate-50 text-slate-900 text-xs px-3.5 py-2.5 rounded-lg border border-slate-300 focus:border-blue-600 focus:bg-white focus:outline-none" />
                </div>
                <div>
                  <label class="block text-xs font-mono text-slate-700 mb-1">Authorized Contact Phone *</label>
                  <input type="tel" required placeholder="+91 98765 43210" class="w-full bg-slate-50 text-slate-900 text-xs px-3.5 py-2.5 rounded-lg border border-slate-300 focus:border-blue-600 focus:bg-white focus:outline-none font-mono" />
                </div>
              </div>

              <div>
                <label class="block text-xs font-mono text-slate-700 mb-1">Tender Reference No. of Interest</label>
                <input type="text" id="tenderRefInput" placeholder="e.g. EDL/GOV/NHAI-EXP/2026/042 (or General EOI)" class="w-full bg-slate-50 text-slate-900 text-xs px-3.5 py-2.5 rounded-lg border border-slate-300 focus:border-blue-600 focus:bg-white focus:outline-none font-mono" />
              </div>

              <div>
                <label class="block text-xs font-mono text-slate-700 mb-1">Specialization / Scope Offered</label>
                <select class="w-full bg-slate-50 text-slate-900 text-xs px-3.5 py-2.5 rounded-lg border border-slate-300 focus:border-blue-600 focus:bg-white focus:outline-none">
                  <option>Bridge Piling & Deep Caisson Works</option>
                  <option>Highway Slipform PQC Paving</option>
                  <option>Structural Steel Fabrication & Launching</option>
                  <option>SCADA, BMS & Electrical High-Tension Substations</option>
                  <option>Water Treatment / Pipeline Laying</option>
                  <option>Material Supply (Cement / TMT Reinforcement Steel)</option>
                </select>
              </div>

              <div>
                <label class="block text-xs font-mono text-slate-700 mb-1">Past Experience Summary & Turnover</label>
                <textarea rows="2" placeholder="Briefly describe key completed projects, peak annual turnover, and machinery assets..." class="w-full bg-slate-50 text-slate-900 text-xs px-3.5 py-2 rounded-lg border border-slate-300 focus:border-blue-600 focus:bg-white focus:outline-none"></textarea>
              </div>

              <div class="flex items-center text-[11px] text-slate-600 space-x-2 pt-1">
                <input type="checkbox" required id="integrityCheck" class="rounded border-slate-300 text-blue-900" />
                <label for="integrityCheck">We confirm compliance with CVC anti-bribery standards and authentic record submission.</label>
              </div>

              <button type="submit" class="w-full py-3 bg-slate-900 hover:bg-slate-800 text-white font-bold text-xs rounded-lg transition-all shadow-xs flex items-center justify-center font-mono">
                <i data-lucide="check-check" class="w-4 h-4 mr-2 text-amber-400"></i>
                Submit Formal EOI Application
              </button>
            </form>
          </div>
        </div>

      </div>
    </div>
  </section>

</GovLayout>
