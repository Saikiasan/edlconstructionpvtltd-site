---
import GovLayout from '../../layouts/GovLayout.astro';
import EmpanelmentGrid from '../../components/gov/EmpanelmentGrid.astro';
import TenderBoard from '../../components/gov/TenderBoard.astro';
import GovProjectCard from '../../components/gov/GovProjectCard.astro';
---

<GovLayout title="Government & Public Sector Infrastructure EPC Division" activeGovPage="overview">
  
  <!-- Hero Section with Light Institutional Blueprint Grid -->
  <section class="relative bg-white py-16 sm:py-24 overflow-hidden gov-pattern-grid-light border-b border-slate-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-8 relative z-10">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-12 items-center">
        
        <!-- Left Hero Copy -->
        <div class="lg:col-span-7 space-y-6">
          <div class="inline-flex items-center space-x-2 bg-amber-50 border border-amber-200 rounded-full px-3.5 py-1.5 text-xs font-mono text-amber-900 font-semibold shadow-2xs">
            <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
            <span>PUBLIC SECTOR INFRASTRUCTURE & EPC PORTAL</span>
          </div>

          <h1 class="text-3xl sm:text-5xl lg:text-6xl font-syne font-extrabold text-slate-900 leading-tight tracking-tight">
            Nation Building Through <span class="text-blue-900">Resilient Infrastructure</span>
          </h1>

          <p class="text-slate-600 text-base sm:text-lg leading-relaxed max-w-2xl font-normal">
            EDL Construction Pvt Ltd partners with Central Ministries, State PWDs, NHAI, Metro Rail Corporations, and Urban Development Authorities to deliver mega-scale highways, deep-foundation river bridges, mass transit corridors, and green administrative complexes under uncompromising statutory compliance.
          </p>

          <!-- Key Metrics Badges (Light Theme) -->
          <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 pt-2">
            <div class="bg-slate-50 p-4 rounded-xl border border-slate-200 shadow-2xs">
              <span class="block text-2xl sm:text-3xl font-syne font-extrabold text-slate-900">12.5M+</span>
              <span class="text-[11px] font-mono text-slate-500 uppercase font-semibold">Safe Man-Hours</span>
            </div>
            <div class="bg-slate-50 p-4 rounded-xl border border-slate-200 shadow-2xs">
              <span class="block text-2xl sm:text-3xl font-syne font-extrabold text-amber-800">Class-1</span>
              <span class="text-[11px] font-mono text-slate-500 uppercase font-semibold">CPWD / MoRTH Status</span>
            </div>
            <div class="bg-slate-50 p-4 rounded-xl border border-slate-200 shadow-2xs">
              <span class="block text-2xl sm:text-3xl font-syne font-extrabold text-slate-900">450+</span>
              <span class="text-[11px] font-mono text-slate-500 uppercase font-semibold">Lane-Km Delivered</span>
            </div>
            <div class="bg-slate-50 p-4 rounded-xl border border-slate-200 shadow-2xs">
              <span class="block text-2xl sm:text-3xl font-syne font-extrabold text-emerald-700">100%</span>
              <span class="text-[11px] font-mono text-slate-500 uppercase font-semibold">CVC & NABL Adherence</span>
            </div>
          </div>

          <!-- Hero Action CTAs -->
          <div class="flex flex-wrap gap-3.5 pt-3">
            <a href="/gov/tenders" class="px-6 py-3.5 bg-slate-900 hover:bg-slate-800 text-white font-bold text-sm rounded-xl transition-all duration-200 shadow-sm flex items-center">
              <i data-lucide="file-search" class="w-4 h-4 mr-2 text-amber-400"></i>
              View Active E-Tenders & RFPs
            </a>
            <a href="/gov/infrastructure" class="px-6 py-3.5 bg-white hover:bg-slate-50 text-slate-800 font-semibold text-sm rounded-xl border border-slate-300 transition-all flex items-center shadow-xs">
              <i data-lucide="layers" class="w-4 h-4 mr-2 text-blue-800"></i>
              Explore Public Works Portfolio
            </a>
          </div>
        </div>

        <!-- Right Hero Live Notice Panel (Light Theme) -->
        <div class="lg:col-span-5">
          <div class="bg-white rounded-2xl p-6 sm:p-7 border border-slate-200 shadow-md space-y-5">
            <div class="flex items-center justify-between border-b border-slate-100 pb-3.5">
              <div class="flex items-center space-x-2.5">
                <span class="w-2.5 h-2.5 rounded-full bg-emerald-500"></span>
                <h3 class="text-slate-900 font-syne font-bold text-base">Public Procurement Notice Board</h3>
              </div>
              <span class="text-[11px] font-mono bg-emerald-50 text-emerald-800 font-semibold px-2 py-0.5 rounded border border-emerald-200">
                Live E-Procurement
              </span>
            </div>

            <!-- Notice 1 -->
            <div class="p-3.5 rounded-xl bg-slate-50 border border-slate-200 hover:border-slate-300 transition-colors">
              <div class="flex justify-between text-[11px] font-mono text-blue-900 font-semibold mb-1">
                <span>Ref: NHAI-EXP/2026/042</span>
                <span class="text-amber-800">Due: 25 Sep 2026</span>
              </div>
              <h4 class="text-slate-900 font-semibold text-xs leading-snug">
                6-Lane Access-Controlled Greenfield Expressway (Package-III)
              </h4>
              <p class="text-[11px] text-slate-500 mt-1">Estimated Value: ₹ 1,480 Cr • MoRTH / NHAI Standard</p>
            </div>

            <!-- Notice 2 -->
            <div class="p-3.5 rounded-xl bg-slate-50 border border-slate-200 hover:border-slate-300 transition-colors">
              <div class="flex justify-between text-[11px] font-mono text-blue-900 font-semibold mb-1">
                <span>Ref: MORTH-BRG/2026/018</span>
                <span class="text-amber-800">Due: 05 Oct 2026</span>
              </div>
              <h4 class="text-slate-900 font-semibold text-xs leading-snug">
                4.8 Km Extradosed 6-Lane River Bridge across Brahmaputra
              </h4>
              <p class="text-[11px] text-slate-500 mt-1">Estimated Value: ₹ 2,120 Cr • Zone V Seismic Design</p>
            </div>

            <!-- Nodal Desk Quick Access -->
            <div class="pt-2 border-t border-slate-100 flex items-center justify-between text-xs">
              <span class="text-slate-500 font-mono">Nodal Officer Direct Line:</span>
              <a href="/gov/liaison" class="text-blue-900 hover:underline font-bold flex items-center">
                Contact Desk <i data-lucide="chevron-right" class="w-3.5 h-3.5 ml-0.5"></i>
              </a>
            </div>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- Section 1: Official Empanellment & Statutory Accreditations -->
  <section class="py-16 sm:py-20 bg-slate-50 border-b border-slate-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-8">
      <div class="flex flex-col md:flex-row md:items-end justify-between mb-10 gap-4">
        <div>
          <div class="inline-flex items-center text-xs font-mono uppercase tracking-wider text-amber-800 mb-2 font-bold">
            <i data-lucide="award" class="w-3.5 h-3.5 mr-1.5 text-amber-700"></i> Statutory Contractor Empanelment
          </div>
          <h2 class="text-2xl sm:text-4xl font-syne font-extrabold text-slate-900 tracking-tight">
            Accredited by National Infrastructure Authorities
          </h2>
        </div>
        <p class="text-xs text-slate-600 max-w-md">
          Pre-qualified Class-1 Special Category contractor with unrestricted bidding limits, certified financial solvency, and validated safety records.
        </p>
      </div>

      <EmpanelmentGrid />
    </div>
  </section>

  <!-- Section 2: Core Public Sector EPC Verticals -->
  <section class="py-16 sm:py-20 bg-white border-b border-slate-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-8">
      <div class="text-center max-w-3xl mx-auto mb-14 space-y-2.5">
        <span class="inline-block text-xs font-mono uppercase tracking-widest text-amber-800 font-bold">
          Strategic Engineering Capabilities
        </span>
        <h2 class="text-2xl sm:text-4xl font-syne font-extrabold text-slate-900 tracking-tight">
          Public Infrastructure Engineering Verticals
        </h2>
        <p class="text-sm text-slate-600">
          Heavy civil engineering with deep domain expertise in transport corridors, marine structures, mass transit, and sustainable civic spaces.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        
        <!-- Vertical 1 -->
        <div class="bg-white p-6 rounded-2xl border border-slate-200 hover:border-slate-300 shadow-xs hover:shadow-md transition-all group">
          <div class="h-12 w-12 rounded-xl bg-amber-50 border border-amber-200 text-amber-800 flex items-center justify-center mb-4 group-hover:scale-105 transition-transform">
            <i data-lucide="route" class="w-6 h-6"></i>
          </div>
          <h3 class="text-slate-900 font-syne font-bold text-lg mb-2 group-hover:text-blue-900 transition-colors">Highways & Expressways</h3>
          <p class="text-xs text-slate-600 leading-relaxed mb-4">
            Pavement Quality Concrete (PQC), deep sub-base stabilization, automatic slipform paving, and smart tolling infrastructure for high-density national corridors.
          </p>
          <div class="pt-3 border-t border-slate-100 text-[11px] font-mono text-slate-500 flex justify-between">
            <span>IRC:SP:84 Adherence</span>
            <span class="text-amber-800 font-bold">450+ Lane Km</span>
          </div>
        </div>

        <!-- Vertical 2 -->
        <div class="bg-white p-6 rounded-2xl border border-slate-200 hover:border-slate-300 shadow-xs hover:shadow-md transition-all group">
          <div class="h-12 w-12 rounded-xl bg-blue-50 border border-blue-200 text-blue-800 flex items-center justify-center mb-4 group-hover:scale-105 transition-transform">
            <i data-lucide="anchor" class="w-6 h-6"></i>
          </div>
          <h3 class="text-slate-900 font-syne font-bold text-lg mb-2 group-hover:text-blue-900 transition-colors">Bridges & Marine Structures</h3>
          <p class="text-xs text-slate-600 leading-relaxed mb-4">
            Cable-stayed, extradosed, and balanced cantilever spans over tidal rivers and deep marine channels with specialized seismic isolation bearings.
          </p>
          <div class="pt-3 border-t border-slate-100 text-[11px] font-mono text-slate-500 flex justify-between">
            <span>Seismic Zone V Certified</span>
            <span class="text-blue-900 font-bold">Deep Caissons</span>
          </div>
        </div>

        <!-- Vertical 3 -->
        <div class="bg-white p-6 rounded-2xl border border-slate-200 hover:border-slate-300 shadow-xs hover:shadow-md transition-all group">
          <div class="h-12 w-12 rounded-xl bg-emerald-50 border border-emerald-200 text-emerald-800 flex items-center justify-center mb-4 group-hover:scale-105 transition-transform">
            <i data-lucide="train" class="w-6 h-6"></i>
          </div>
          <h3 class="text-slate-900 font-syne font-bold text-lg mb-2 group-hover:text-blue-900 transition-colors">Metro & Rail Transit</h3>
          <p class="text-xs text-slate-600 leading-relaxed mb-4">
            Precast segmental U-girder viaduct construction, elevated stations, multimodal transport hubs, and ballastless track bed engineering.
          </p>
          <div class="pt-3 border-t border-slate-100 text-[11px] font-mono text-slate-500 flex justify-between">
            <span>RDSO / IRS Standards</span>
            <span class="text-emerald-800 font-bold">Heavy Gantries</span>
          </div>
        </div>

        <!-- Vertical 4 -->
        <div class="bg-white p-6 rounded-2xl border border-slate-200 hover:border-slate-300 shadow-xs hover:shadow-md transition-all group">
          <div class="h-12 w-12 rounded-xl bg-purple-50 border border-purple-200 text-purple-800 flex items-center justify-center mb-4 group-hover:scale-105 transition-transform">
            <i data-lucide="landmark" class="w-6 h-6"></i>
          </div>
          <h3 class="text-slate-900 font-syne font-bold text-lg mb-2 group-hover:text-blue-900 transition-colors">Administrative & Judicial Complexes</h3>
          <p class="text-xs text-slate-600 leading-relaxed mb-4">
            Turnkey institutional secretariats, high courts, university campuses, and civic centers engineered with GRIHA 5-Star net-zero parameters.
          </p>
          <div class="pt-3 border-t border-slate-100 text-[11px] font-mono text-slate-500 flex justify-between">
            <span>CPWD Plinth Norms</span>
            <span class="text-purple-800 font-bold">GRIHA 5-Star</span>
          </div>
        </div>

        <!-- Vertical 5 -->
        <div class="bg-white p-6 rounded-2xl border border-slate-200 hover:border-slate-300 shadow-xs hover:shadow-md transition-all group">
          <div class="h-12 w-12 rounded-xl bg-cyan-50 border border-cyan-200 text-cyan-800 flex items-center justify-center mb-4 group-hover:scale-105 transition-transform">
            <i data-lucide="droplets" class="w-6 h-6"></i>
          </div>
          <h3 class="text-slate-900 font-syne font-bold text-lg mb-2 group-hover:text-blue-900 transition-colors">Smart Water & Environmental Works</h3>
          <p class="text-xs text-slate-600 leading-relaxed mb-4">
            Continuous 24x7 pressurized drinking water networks, SCADA pump houses, and Zero Liquid Discharge (ZLD) municipal sewage treatment plants.
          </p>
          <div class="pt-3 border-t border-slate-100 text-[11px] font-mono text-slate-500 flex justify-between">
            <span>CPHEEO Norms</span>
            <span class="text-cyan-800 font-bold">150+ MLD Network</span>
          </div>
        </div>

        <!-- Vertical 6 -->
        <div class="bg-white p-6 rounded-2xl border border-slate-200 hover:border-slate-300 shadow-xs hover:shadow-md transition-all group">
          <div class="h-12 w-12 rounded-xl bg-rose-50 border border-rose-200 text-rose-800 flex items-center justify-center mb-4 group-hover:scale-105 transition-transform">
            <i data-lucide="shield" class="w-6 h-6"></i>
          </div>
          <h3 class="text-slate-900 font-syne font-bold text-lg mb-2 group-hover:text-blue-900 transition-colors">Strategic & Defense Works</h3>
          <p class="text-xs text-slate-600 leading-relaxed mb-4">
            High-altitude all-weather military logistics roads, hardened aircraft shelters, specialized ammunition storage depots, and perimeter surveillance bastions.
          </p>
          <div class="pt-3 border-t border-slate-100 text-[11px] font-mono text-slate-500 flex justify-between">
            <span>MES / BRO Specifications</span>
            <span class="text-rose-800 font-bold">Zone V High-Altitude</span>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- Section 3: Active Tender Notice Board Preview -->
  <section class="py-16 sm:py-20 bg-slate-50 border-b border-slate-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-8">
      <div class="flex flex-col md:flex-row md:items-end justify-between mb-8 gap-4">
        <div>
          <span class="inline-flex items-center text-xs font-mono uppercase tracking-wider text-amber-800 mb-2 font-bold">
            <i data-lucide="file-text" class="w-3.5 h-3.5 mr-1.5 text-amber-700"></i> Public Procurement Gateway
          </span>
          <h2 class="text-2xl sm:text-4xl font-syne font-extrabold text-slate-900 tracking-tight">
            Active E-Tenders & Expression of Interest (EOI)
          </h2>
        </div>
        <a href="/gov/tenders" class="text-xs font-mono font-bold text-blue-900 hover:underline flex items-center">
          Open Full E-Procurement Desk <i data-lucide="arrow-right" class="w-3.5 h-3.5 ml-1"></i>
        </a>
      </div>

      <TenderBoard />
    </div>
  </section>

  <!-- Section 4: Signature Landmark Public Infrastructure -->
  <section class="py-16 sm:py-20 bg-white border-b border-slate-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-8">
      <div class="flex flex-col md:flex-row md:items-end justify-between mb-10 gap-4">
        <div>
          <span class="text-xs font-mono uppercase tracking-wider text-amber-800 mb-2 font-bold block">
            Execution Track Record
          </span>
          <h2 class="text-2xl sm:text-4xl font-syne font-extrabold text-slate-900 tracking-tight">
            Featured Public Infrastructure Works
          </h2>
        </div>
        <p class="text-xs text-slate-600 max-w-md">
          Explore benchmark government projects delivered across seismic, marine, and urban transit engineering domains.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        
        <GovProjectCard 
          title="Brahmaputra Marine Expressway Bridge"
          category="Bridges & Marine"
          authority="MoRTH / Assam PWD"
          location="Guwahati Corridor"
          status="Ahead of Schedule"
          progress={78}
          value="₹ 2,120.00 Cr"
          lengthOrArea="6.4 Km River Span"
          specs={[
            "M70 Self-Compacting Underwater Concrete",
            "Seismic Zone V Base Dampeners",
            "45m Deep Well Foundation Caissons"
          ]}
          codeCompliance="IRC:112 & IRC:SP:69"
        />

        <GovProjectCard 
          title="National Express Highway Corridor (Pkg IV)"
          category="Highways & Expressways"
          authority="National Highways Authority (NHAI)"
          location="Western Industrial Corridor"
          status="Commissioned & Handed Over"
          progress={100}
          value="₹ 1,480.00 Cr"
          lengthOrArea="48.5 Km (6-Lane Dual PQC)"
          specs={[
            "Slipform Paving with Dowel Bar Inserter",
            "Automated Weigh-In-Motion Sensors",
            "100% Rainwater Harvesting Swales"
          ]}
          codeCompliance="IRC:SP:84-2019"
        />

        <GovProjectCard 
          title="State Integrated Secretariat & High Court Annex"
          category="Administrative Complex"
          authority="Central Public Works Dept (CPWD)"
          location="Capital Administrative Zone"
          status="Final Finishing Stage"
          progress={92}
          value="₹ 620.00 Cr"
          lengthOrArea="1,250,000 Sq. Ft. Built-up"
          specs={[
            "GRIHA 5-Star Net-Zero Carbon Standard",
            "Post-Tensioned Column-Free Halls",
            "Integrated Dual-Power SCADA BMS"
          ]}
          codeCompliance="CPWD & NBC 2016"
        />

      </div>

      <div class="text-center mt-10">
        <a href="/gov/infrastructure" class="inline-flex items-center px-6 py-3 rounded-xl bg-slate-100 hover:bg-slate-200 text-slate-900 text-xs font-mono font-bold border border-slate-300 transition-colors shadow-2xs">
          View Complete Government Portfolio Matrix <i data-lucide="arrow-right" class="w-3.5 h-3.5 ml-2 text-amber-700"></i>
        </a>
      </div>
    </div>
  </section>

  <!-- Section 5: Nodal Protocol & Government Liaison Banner (Light Slate / Navy Accent) -->
  <section class="py-16 bg-slate-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-8">
      <div class="bg-white rounded-2xl p-8 sm:p-12 border border-slate-200 shadow-md flex flex-col lg:flex-row items-center justify-between gap-8">
        <div class="space-y-3 max-w-2xl">
          <span class="text-xs font-mono text-amber-800 uppercase font-bold tracking-wider">
            🏛️ Dedicated Government Stakeholder Desk
          </span>
          <h3 class="text-2xl sm:text-3xl font-syne font-extrabold text-slate-900">
            Connect Directly with our Chief Infrastructure Engineer
          </h3>
          <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">
            For Ministry Officials, Project Directors, Principal Secretaries, and Nodal Engineers requesting technical presentations, pre-bid clarification sessions, or statutory audit verifications.
          </p>
        </div>

        <div class="flex flex-col sm:flex-row gap-3 w-full lg:w-auto">
          <a href="/gov/liaison" class="px-6 py-3.5 bg-slate-900 hover:bg-slate-800 text-white font-bold text-xs rounded-xl transition-all shadow-sm flex items-center justify-center font-mono whitespace-nowrap">
            <i data-lucide="user-check" class="w-4 h-4 mr-2 text-amber-400"></i>
            Schedule Nodal Protocol Briefing
          </a>
          <a href="mailto:gov.epc@edlconstructionpvtltd.in" class="px-6 py-3.5 bg-slate-100 hover:bg-slate-200 text-slate-800 font-semibold text-xs rounded-xl border border-slate-300 transition-colors flex items-center justify-center font-mono whitespace-nowrap">
            <i data-lucide="mail" class="w-4 h-4 mr-2 text-slate-600"></i>
            Official Email Dispatch
          </a>
        </div>
      </div>
    </div>
  </section>

</GovLayout>
