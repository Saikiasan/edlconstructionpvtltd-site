---
import GovLayout from '../../layouts/GovLayout.astro';
import GovProjectCard from '../../components/gov/GovProjectCard.astro';

const projects = [
  {
    title: "Heavy Civil River Span & Deep Foundation Bridge Works",
    category: "Bridges & Marine",
    categoryKey: "bridges",
    authority: "Public Works & Transportation Sector",
    location: "North-East & Regional River Corridors",
    status: "Engineering Specification",
    progress: 85,
    value: "Turnkey Civil Package",
    lengthOrArea: "Multi-Span River Crossing",
    specs: [
      "M60 & M70 High-Performance Self-Compacting Concrete",
      "Seismic Zone V Base Isolation & Pier Protection Dampeners",
      "Bored Cast-In-Situ Piles & Deep Well Caissons",
      "Heavy Gantry Girder Erection & Post-Tensioning"
    ],
    codeCompliance: "IRC:112 & IRC:SP:69",
    image: "/frames/frame_0010.jpg"
  },
  {
    title: "Rigid Concrete Access Highway & Corridor Development",
    category: "Highways & Expressways",
    categoryKey: "highways",
    authority: "Highway Infrastructure Authorities",
    location: "Industrial Corridor Links",
    status: "Delivered & Commissioned",
    progress: 100,
    value: "Item-Rate / EPC Model",
    lengthOrArea: "Dual-Carriageway PQC Section",
    specs: [
      "Slipform Paving with Automated Dowel Bar Inserter",
      "Pavement Quality Concrete (PQC) with Granular Sub-Base",
      "Drainage Culverts & Geotextile Reinforced Embankments",
      "Continuous Quality Compaction Surveillance"
    ],
    codeCompliance: "IRC:SP:84 & MoRTH Section 600",
    image: "/frames/frame_0050.jpg"
  },
  {
    title: "Elevated Transit Corridors & Precast Segment Viaducts",
    category: "Metro & Rail Transit",
    categoryKey: "transit",
    authority: "Urban Mass Transit Systems",
    location: "Metropolitan Connectivity Sectors",
    status: "Civil Execution",
    progress: 70,
    value: "Structural Viaduct Scope",
    lengthOrArea: "Elevated Corridor & Station Framework",
    specs: [
      "Precast Segmental Box Girder Construction",
      "Heavy Load Launching Gantry Coordination",
      "Ballastless RCC Plinth Track Bed Casting",
      "Vibration Isolation & Structural Health Monitoring"
    ],
    codeCompliance: "RDSO & IRS Bridge Code",
    image: "/frames/frame_0080.jpg"
  },
  {
    title: "Integrated Administrative Complex & Civic Centers",
    category: "Institutional Complexes",
    categoryKey: "institutional",
    authority: "Institutional Infrastructure Authorities",
    location: "Regional Administrative Sectors",
    status: "Execution & Finishes",
    progress: 90,
    value: "Turnkey Building Package",
    lengthOrArea: "Multi-Storey Structural RCC Framework",
    specs: [
      "Green Building Design & Energy Efficient Envelope",
      "Post-Tensioned Large Column-Free Meeting Halls",
      "Central HVAC & Building Management Integration",
      "Comprehensive Fire Suppression per NBC 2016"
    ],
    codeCompliance: "NBC 2016 & CPWD Specifications",
    image: "/frames/frame_0110.jpg"
  },
  {
    title: "Municipal Water Distribution & Environmental Utilities",
    category: "Smart Water & Utilities",
    categoryKey: "water",
    authority: "Public Health Engineering Sector",
    location: "Municipal & Smart City Zones",
    status: "Testing & Commissioning",
    progress: 88,
    value: "Civic Utility Framework",
    lengthOrArea: "Transmission Network & Treatment Works",
    specs: [
      "Ductile Iron (DI) K9 Transmission Main Pipeline",
      "Sequential Batch Reactor (SBR) Sewage Treatment Unit",
      "Automated Ultrasonic Flow Meters & SCADA Telemetry",
      "Zero-Liquid Discharge & Water Recycling"
    ],
    codeCompliance: "CPHEEO Manual on Water Supply",
    image: "/frames/frame_0140.jpg"
  },
  {
    title: "All-Weather Strategic Logistics Bypass Roads",
    category: "Strategic & Defense Works",
    categoryKey: "strategic",
    authority: "Regional Road Infrastructure",
    location: "High-Altitude & Challenging Terrains",
    status: "Under Construction",
    progress: 60,
    value: "Specialized Road Works",
    lengthOrArea: "Heavy Load Roadway & Slope Protection",
    specs: [
      "Reinforced Concrete Retaining Walls & Breast Walls",
      "Polymer-Modified Bitumen for Extreme Climates",
      "Bio-Engineering Geotextile Slope Stabilization",
      "High-Capacity Culverts & Drainage Channels"
    ],
    codeCompliance: "IRC Special Publications",
    image: "/frames/frame_0180.jpg"
  }
];
---

<GovLayout title="Public Infrastructure & EPC Portfolio" activeGovPage="infrastructure">
  
  <!-- Sub-page Header (Light Theme) -->
  <section class="bg-white py-14 sm:py-20 border-b border-slate-200 gov-pattern-grid-light relative">
    <div class="max-w-7xl mx-auto px-4 sm:px-8 relative z-10">
      <div class="max-w-3xl space-y-4">
        <div class="inline-flex items-center space-x-2 bg-amber-50 border border-amber-200 rounded-full px-3 py-1 text-xs font-mono text-amber-900 font-semibold shadow-2xs">
          <i data-lucide="layers" class="w-3.5 h-3.5 mr-1 text-amber-700"></i>
          PUBLIC WORKS & NATION BUILDING MATRIX
        </div>
        <h1 class="text-3xl sm:text-5xl font-syne font-extrabold text-slate-900 tracking-tight">
          Public Infrastructure & EPC Portfolio
        </h1>
        <p class="text-slate-600 text-sm sm:text-base leading-relaxed font-normal">
          A showcase of high-precision civil engineering delivered for national and state public authorities. Engineered with millimeter tolerances, rigorous seismic simulations, and certified lifecycle longevity.
        </p>
      </div>
    </div>
  </section>

  <!-- Engineering Standards Bar (Light Theme) -->
  <div class="bg-slate-50 border-b border-slate-200 py-3.5">
    <div class="max-w-7xl mx-auto px-4 sm:px-8 flex flex-wrap items-center justify-between gap-4 text-xs font-mono text-slate-600">
      <div class="flex items-center space-x-2">
        <i data-lucide="check-circle" class="w-4 h-4 text-emerald-600"></i>
        <span><strong>IRC Standards:</strong> IRC:112 (Bridges) • IRC:SP:84 (Highways)</span>
      </div>
      <div class="flex items-center space-x-2">
        <i data-lucide="shield" class="w-4 h-4 text-amber-700"></i>
        <span><strong>IS Codes:</strong> IS 456 (Plain/Reinforced) • IS 1893 (Seismic)</span>
      </div>
      <div class="flex items-center space-x-2">
        <i data-lucide="leaf" class="w-4 h-4 text-emerald-600"></i>
        <span><strong>Green Norms:</strong> GRIHA 5-Star & IGBC Platinum Benchmarks</span>
      </div>
    </div>
  </div>

  <!-- Projects Grid Section -->
  <section class="py-14 sm:py-20 bg-slate-50/70">
    <div class="max-w-7xl mx-auto px-4 sm:px-8">
      
      <!-- Sector Tabs (Light Theme) -->
      <div class="flex items-center space-x-2 overflow-x-auto pb-4 mb-8 text-xs font-mono" id="infraTabs">
        <button data-cat="all" class="infra-tab-btn px-4 py-2 rounded-lg bg-slate-900 text-white font-bold whitespace-nowrap shadow-xs">
          All Sectors ({projects.length})
        </button>
        <button data-cat="highways" class="infra-tab-btn px-4 py-2 rounded-lg bg-white text-slate-700 hover:text-slate-900 border border-slate-300 whitespace-nowrap shadow-2xs">
          Highways & Expressways
        </button>
        <button data-cat="bridges" class="infra-tab-btn px-4 py-2 rounded-lg bg-white text-slate-700 hover:text-slate-900 border border-slate-300 whitespace-nowrap shadow-2xs">
          Bridges & Marine
        </button>
        <button data-cat="transit" class="infra-tab-btn px-4 py-2 rounded-lg bg-white text-slate-700 hover:text-slate-900 border border-slate-300 whitespace-nowrap shadow-2xs">
          Metro & Rail
        </button>
        <button data-cat="institutional" class="infra-tab-btn px-4 py-2 rounded-lg bg-white text-slate-700 hover:text-slate-900 border border-slate-300 whitespace-nowrap shadow-2xs">
          Administrative Complexes
        </button>
        <button data-cat="water" class="infra-tab-btn px-4 py-2 rounded-lg bg-white text-slate-700 hover:text-slate-900 border border-slate-300 whitespace-nowrap shadow-2xs">
          Water & Utilities
        </button>
        <button data-cat="strategic" class="infra-tab-btn px-4 py-2 rounded-lg bg-white text-slate-700 hover:text-slate-900 border border-slate-300 whitespace-nowrap shadow-2xs">
          Strategic / Defense
        </button>
      </div>

      <!-- Projects Grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6" id="infraGrid">
        {projects.map(proj => (
          <div class="infra-card" data-category={proj.categoryKey}>
            <GovProjectCard 
              title={proj.title}
              category={proj.category}
              authority={proj.authority}
              location={proj.location}
              status={proj.status}
              progress={proj.progress}
              value={proj.value}
              lengthOrArea={proj.lengthOrArea}
              specs={proj.specs}
              codeCompliance={proj.codeCompliance}
              image={proj.image}
            />
          </div>
        ))}
      </div>

    </div>
  </section>

  <!-- Technical Heavy Machinery & Batching Fleet (Light Theme) -->
  <section class="py-16 bg-white border-t border-slate-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-8">
      <div class="max-w-3xl mb-10">
        <span class="text-xs font-mono uppercase tracking-wider text-amber-800 font-bold block mb-1">
          Mechanical Assets & Fleet Strength
        </span>
        <h2 class="text-2xl sm:text-3xl font-syne font-extrabold text-slate-900">
          Dedicated High-Capacity Construction Machinery
        </h2>
      </div>

      <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-4 text-center">
        <div class="p-4 rounded-xl bg-slate-50 border border-slate-200 shadow-2xs">
          <span class="block text-2xl font-syne font-extrabold text-amber-800">Batching</span>
          <span class="text-xs text-slate-600 mt-1 block">Automated Concrete Batching Plants</span>
        </div>
        <div class="p-4 rounded-xl bg-slate-50 border border-slate-200 shadow-2xs">
          <span class="block text-2xl font-syne font-extrabold text-slate-900">Paving</span>
          <span class="text-xs text-slate-600 mt-1 block">Heavy Slipform Concrete Pavers</span>
        </div>
        <div class="p-4 rounded-xl bg-slate-50 border border-slate-200 shadow-2xs">
          <span class="block text-2xl font-syne font-extrabold text-emerald-700">Gantries</span>
          <span class="text-xs text-slate-600 mt-1 block">Segmental Girder Launching Gantries</span>
        </div>
        <div class="p-4 rounded-xl bg-slate-50 border border-slate-200 shadow-2xs">
          <span class="block text-2xl font-syne font-extrabold text-slate-900">Piling</span>
          <span class="text-xs text-slate-600 mt-1 block">Hydraulic Rotary Bored Piling Rigs</span>
        </div>
        <div class="p-4 rounded-xl bg-slate-50 border border-slate-200 shadow-2xs">
          <span class="block text-2xl font-syne font-extrabold text-blue-900">Transit</span>
          <span class="text-xs text-slate-600 mt-1 block">GPS-Monitored Transit Mixers</span>
        </div>
        <div class="p-4 rounded-xl bg-slate-50 border border-slate-200 shadow-2xs">
          <span class="block text-2xl font-syne font-extrabold text-emerald-700">Testing</span>
          <span class="text-xs text-slate-600 mt-1 block">Site Quality Surveillance Labs</span>
        </div>
      </div>
    </div>
  </section>

</GovLayout>

<script is:inline>
  const tabBtns = document.querySelectorAll('.infra-tab-btn');
  const infraCards = document.querySelectorAll('.infra-card');

  tabBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      tabBtns.forEach(b => {
        b.classList.remove('bg-slate-900', 'text-white', 'font-bold', 'shadow-xs');
        b.classList.add('bg-white', 'text-slate-700', 'border', 'border-slate-300', 'shadow-2xs');
      });
      btn.classList.add('bg-slate-900', 'text-white', 'font-bold', 'shadow-xs');
      btn.classList.remove('bg-white', 'text-slate-700', 'border', 'border-slate-300', 'shadow-2xs');

      const selectedCat = btn.getAttribute('data-cat');
      infraCards.forEach(card => {
        const cardCat = card.getAttribute('data-category');
        if (selectedCat === 'all' || cardCat === selectedCat) {
          card.classList.remove('hidden');
        } else {
          card.classList.add('hidden');
        }
      });
    });
  });
</script>
