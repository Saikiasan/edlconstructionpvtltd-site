---
interface Props {
  title: string;
  activeGovPage?: string;
  description?: string;
}

const { 
  title, 
  activeGovPage = 'overview',
  description = 'EDL Construction Pvt Ltd — Government & Public Sector Infrastructure EPC Division. Empanelled Class-1 Special Category contractor for Highways, Bridges, Metro Transit, and Institutional Complexes.'
} = Astro.props;

import GovHeader from '../components/gov/GovHeader.astro';
import GovFooter from '../components/gov/GovFooter.astro';
---

<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} | EDL Construction Public Sector Portal</title>
    <meta name="description" content={description} />
    
    <link rel="icon" type="image/jpeg" href="/favicon.jpeg" />
    <link rel="shortcut icon" href="/favicon.jpeg" />
    <link rel="apple-touch-icon" href="/favicon.jpeg" />
    
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&family=Syne:wght@600;700;800&family=JetBrains+Mono:wght@400;500;600;700&display=swap" rel="stylesheet">
    
    <script src="https://unpkg.com/lucide@latest"></script>
    
    <style is:global>
      :root {
        --gov-blue-primary: #0A2540;
        --gov-blue-accent: #1E3A8A;
        --gov-gold: #B45309;
        --gov-gold-bright: #D97706;
        --gov-emerald: #047857;
        --gov-slate: #334155;
        --gov-bg: #FFFFFF;
        --gov-surface: #F8FAFC;
        --gov-border: #E2E8F0;
      }

      body {
        background-color: #F8FAFC;
        color: #0F172A;
        font-family: 'Plus Jakarta Sans', sans-serif;
        overflow-x: hidden;
      }

      .gov-pattern-grid-light {
        background-color: #FFFFFF;
        background-image: 
          linear-gradient(rgba(14, 116, 144, 0.05) 1px, transparent 1px),
          linear-gradient(90deg, rgba(14, 116, 144, 0.05) 1px, transparent 1px),
          linear-gradient(rgba(180, 83, 9, 0.04) 1px, transparent 1px),
          linear-gradient(90deg, rgba(180, 83, 9, 0.04) 1px, transparent 1px);
        background-size: 24px 24px, 24px 24px, 96px 96px, 96px 96px;
      }

      .gov-card-light {
        background: #FFFFFF;
        border: 1px solid #E2E8F0;
        box-shadow: 0 1px 3px 0 rgba(0, 0, 0, 0.05), 0 1px 2px -1px rgba(0, 0, 0, 0.05);
      }

      .gov-card-light-hover {
        transition: all 0.2s ease-in-out;
      }
      .gov-card-light-hover:hover {
        border-color: #CBD5E1;
        box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.08), 0 2px 4px -2px rgba(0, 0, 0, 0.06);
      }

      .gov-gold-shadow {
        box-shadow: 0 4px 14px 0 rgba(180, 83, 9, 0.25);
      }

      ::-webkit-scrollbar {
        width: 8px;
      }
      ::-webkit-scrollbar-track {
        background: #F1F5F9;
      }
      ::-webkit-scrollbar-thumb {
        background: #CBD5E1;
        border-radius: 4px;
      }
      ::-webkit-scrollbar-thumb:hover {
        background: #94A3B8;
      }
    </style>
  </head>
  <body class="selection:bg-amber-100 selection:text-amber-950 flex flex-col min-h-screen bg-[#F8FAFC] text-slate-900">
    <GovHeader activeGovPage={activeGovPage} />
    
    <main class="flex-grow">
      <slot />
    </main>

    <GovFooter />

    <script is:inline>
      if (window.lucide) {
        window.lucide.createIcons();
      }
    </script>
  </body>
</html>
