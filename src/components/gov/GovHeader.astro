---
interface Props {
  activeGovPage?: string;
}

const { activeGovPage = 'overview' } = Astro.props;
---

<!-- Statutory Government Notification Bar (Light Theme) -->
<div class="bg-slate-100 text-slate-700 text-xs px-4 sm:px-8 py-2 flex flex-wrap justify-between items-center border-b border-slate-200">
  <div class="flex items-center space-x-3 sm:space-x-4 flex-wrap gap-y-1">
    <span class="inline-flex items-center text-amber-800 font-semibold tracking-wide">
      <i data-lucide="landmark" class="w-3.5 h-3.5 mr-1.5 text-amber-700"></i>
      Govt. Empanelled Class-1 (Super) EPC Contractor
    </span>
    <span class="hidden md:inline-block text-slate-300">|</span>
    <span class="hidden md:inline-flex items-center text-slate-600">
      <i data-lucide="shield-check" class="w-3.5 h-3.5 mr-1 text-emerald-600"></i>
      GeM Seller ID: GEM-EDL-2026 • CVC Integrity Certified
    </span>
    <span class="hidden xl:inline-block text-slate-300">|</span>
    <span class="hidden xl:inline-flex items-center text-slate-600">
      <i data-lucide="award" class="w-3.5 h-3.5 mr-1 text-blue-700"></i>
      ISO 9001:2015 • ISO 14001:2015 • ISO 45001:2018
    </span>
  </div>

  <div class="flex items-center space-x-3 sm:space-x-4 mt-1 sm:mt-0">
    <div class="inline-flex items-center text-slate-700 bg-white px-2.5 py-0.5 rounded text-[11px] border border-slate-300 font-mono shadow-xs">
      <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse mr-1.5"></span>
      <span id="govIstClock">IST: --:--:--</span>
    </div>

    <!-- Switcher to Main Corporate Website -->
    <a href="/" class="inline-flex items-center text-[11px] font-medium text-slate-700 hover:text-blue-900 bg-white hover:bg-slate-50 px-2.5 py-1 rounded border border-slate-300 transition-colors shadow-xs">
      <i data-lucide="building-2" class="w-3 h-3 mr-1 text-amber-700"></i>
      Corporate Portal <i data-lucide="arrow-up-right" class="w-3 h-3 ml-0.5 text-slate-400"></i>
    </a>
  </div>
</div>

<!-- Main Institutional Header (Light Theme) -->
<header class="sticky top-0 z-50 bg-white/98 backdrop-blur-md border-b border-slate-200 text-slate-900 shadow-sm transition-all duration-300">
  <div class="max-w-7xl mx-auto px-4 sm:px-8 h-20 flex items-center justify-between">
    
    <!-- Brand Logo with Government Division Sub-label -->
    <a href="/gov" class="flex items-center space-x-3.5 group">
      <div class="h-12 w-12 rounded-xl bg-white p-1 border border-slate-300 shadow-xs flex items-center justify-center overflow-hidden flex-shrink-0 group-hover:border-amber-600 transition-colors">
        <img src="/logo.jpeg" alt="EDL Logo" class="h-full w-full object-contain" />
      </div>
      <div class="flex flex-col">
        <div class="flex items-center space-x-2">
          <span class="font-syne font-extrabold text-lg sm:text-xl tracking-tight text-slate-900 leading-none group-hover:text-blue-900 transition-colors">
            EDL <span class="text-amber-700">INFRASTRUCTURE</span>
          </span>
          <span class="bg-amber-100 text-amber-900 text-[10px] font-mono font-bold px-1.5 py-0.5 rounded border border-amber-300 uppercase">
            Govt. EPC
          </span>
        </div>
        <span class="text-[9px] tracking-[0.2em] text-slate-500 uppercase font-mono font-semibold mt-1">
          PUBLIC WORKS & NATION BUILDING DIVISION
        </span>
      </div>
    </a>

    <!-- Desktop Navigation -->
    <nav class="hidden lg:flex items-center space-x-6 xl:space-x-7 text-[13.5px] font-medium text-slate-700">
      <a href="/gov" class={activeGovPage === 'overview' ? 'text-blue-900 font-bold border-b-2 border-amber-600 pb-1' : 'hover:text-blue-900 transition-colors'}>Overview</a>
      <a href="/gov/infrastructure" class={activeGovPage === 'infrastructure' ? 'text-blue-900 font-bold border-b-2 border-amber-600 pb-1' : 'hover:text-blue-900 transition-colors'}>Public Infra</a>
      <a href="/gov/tenders" class={activeGovPage === 'tenders' ? 'text-blue-900 font-bold border-b-2 border-amber-600 pb-1 flex items-center' : 'hover:text-blue-900 transition-colors flex items-center'}>
        <span>Active Tenders</span>
        <span class="ml-1.5 bg-emerald-100 text-emerald-800 text-[10px] px-1.5 py-0.2 rounded-full border border-emerald-300 font-mono font-semibold">Live</span>
      </a>
      <a href="/gov/compliance" class={activeGovPage === 'compliance' ? 'text-blue-900 font-bold border-b-2 border-amber-600 pb-1' : 'hover:text-blue-900 transition-colors'}>Compliance & QA</a>
      <a href="/gov/telemetry" class={activeGovPage === 'telemetry' ? 'text-blue-900 font-bold border-b-2 border-amber-600 pb-1' : 'hover:text-blue-900 transition-colors'}>Live Telemetry</a>
      <a href="/gov/liaison" class={activeGovPage === 'liaison' ? 'text-blue-900 font-bold border-b-2 border-amber-600 pb-1' : 'hover:text-blue-900 transition-colors'}>Nodal Desk</a>
    </nav>

    <!-- Header Action Button & Mobile Trigger -->
    <div class="flex items-center space-x-3">
      <a href="/gov/tenders#submit-eoi" class="hidden sm:inline-flex items-center px-4 py-2 text-xs font-bold text-white bg-slate-900 hover:bg-slate-800 rounded-lg transition-all shadow-xs">
        <i data-lucide="file-check" class="w-3.5 h-3.5 mr-1.5 text-amber-400"></i>
        Submit EOI / Bid
      </a>
      <button id="govMobileMenuBtn" aria-label="Toggle navigation menu" class="lg:hidden p-2 rounded-lg border border-slate-300 text-slate-700 hover:text-slate-900 hover:bg-slate-100 transition-colors">
        <i data-lucide="menu" class="w-5 h-5"></i>
      </button>
    </div>
  </div>

  <!-- Mobile Drawer Menu (Light Theme) -->
  <div id="govMobileMenu" class="hidden lg:hidden bg-white border-b border-slate-200 px-6 py-5 shadow-xl transition-all">
    <nav class="flex flex-col space-y-3 text-sm font-semibold text-slate-800">
      <a href="/gov" class={activeGovPage === 'overview' ? 'text-amber-800 font-bold' : 'hover:text-blue-900 transition-colors'}>Overview</a>
      <a href="/gov/infrastructure" class={activeGovPage === 'infrastructure' ? 'text-amber-800 font-bold' : 'hover:text-blue-900 transition-colors'}>Public Infrastructure Showcase</a>
      <a href="/gov/tenders" class={activeGovPage === 'tenders' ? 'text-amber-800 font-bold flex items-center justify-between' : 'hover:text-blue-900 transition-colors flex items-center justify-between'}>
        <span>E-Tenders & EOI Notice Board</span>
        <span class="bg-emerald-100 text-emerald-800 text-[10px] px-2 py-0.5 rounded-full border border-emerald-300 font-mono">Active</span>
      </a>
      <a href="/gov/compliance" class={activeGovPage === 'compliance' ? 'text-amber-800 font-bold' : 'hover:text-blue-900 transition-colors'}>Statutory Compliance & Vigilance</a>
      <a href="/gov/telemetry" class={activeGovPage === 'telemetry' ? 'text-amber-800 font-bold' : 'hover:text-blue-900 transition-colors'}>Public Works Telemetry & Milestones</a>
      <a href="/gov/liaison" class={activeGovPage === 'liaison' ? 'text-amber-800 font-bold' : 'hover:text-blue-900 transition-colors'}>Nodal Officer & Ministry Liaison Desk</a>
      
      <div class="pt-3 border-t border-slate-200 space-y-2">
        <a href="/gov/tenders#submit-eoi" class="w-full text-center py-2.5 text-xs font-bold text-white bg-slate-900 rounded-lg shadow-sm block">
          Submit EOI / Joint Venture Application
        </a>
        <a href="/" class="w-full text-center py-2 text-xs font-medium text-slate-700 bg-slate-100 rounded-lg border border-slate-300 block hover:text-slate-900">
          ← Switch to EDL Corporate Website
        </a>
      </div>
    </nav>
  </div>
</header>

<script is:inline>
  function updateGovClock() {
    const options = { timeZone: 'Asia/Kolkata', hour: '2-digit', minute: '2-digit', second: '2-digit', hour12: false };
    const el = document.getElementById('govIstClock');
    if (el) el.innerText = 'IST: ' + new Intl.DateTimeFormat('en-IN', options).format(new Date());
  }
  setInterval(updateGovClock, 1000);
  updateGovClock();

  const govMobileBtn = document.getElementById('govMobileMenuBtn');
  const govMobileMenu = document.getElementById('govMobileMenu');
  govMobileBtn?.addEventListener('click', () => {
    govMobileMenu?.classList.toggle('hidden');
  });
</script>
