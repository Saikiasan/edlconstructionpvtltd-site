---
const empanelments = [
  {
    authority: "MoRTH & State PWD Guidelines",
    category: "Roads & Highways Standards",
    scope: "Engineered execution of rigid concrete pavements, flexible overlays, and sub-base stabilization per IRC guidelines.",
    badge: "IRC Compliant",
    icon: "route",
    color: "amber"
  },
  {
    authority: "IS 456:2000 & IS 1893:2016",
    category: "Structural & Seismic Codes",
    scope: "Earthquake-resistant RCC design and ductile detailing for public, commercial, and high-occupancy structures.",
    badge: "Bureau of Indian Standards",
    icon: "shield-check",
    color: "blue"
  },
  {
    authority: "NBC 2016 Guidelines",
    category: "Institutional & Civic Buildings",
    scope: "Fire safety norms, accessibility compliance, structural load tolerances, and life-safety building provisions.",
    badge: "Building Code",
    icon: "landmark",
    color: "emerald"
  },
  {
    authority: "ISO 9001:2015 Management",
    category: "Quality Management System",
    scope: "Systematic quality audits, stage-gate inspections, material batch verification, and milestone documentation.",
    badge: "Quality Certified",
    icon: "award",
    color: "indigo"
  },
  {
    authority: "NABL Verified Lab Testing",
    category: "Compressive & Tensile Testing",
    scope: "Standardized destructive and non-destructive testing for ready-mix concrete, TMT rebar, and aggregate density.",
    badge: "Lab Validated",
    icon: "test-tube",
    color: "cyan"
  },
  {
    authority: "Environmental & Safety Norms",
    category: "EHS & Green Construction",
    scope: "Zero-discharge drainage, dust suppression, worker PPE protocols, and rainwater harvesting integration.",
    badge: "EHS Protocol",
    icon: "leaf",
    color: "rose"
  }
];
---

<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
  {empanelments.map((item) => (
    <div class="bg-white rounded-xl p-6 border border-slate-200 shadow-xs hover:border-amber-400 hover:shadow-md transition-all group relative overflow-hidden">
      <div class="flex items-start justify-between mb-4">
        <div class="h-11 w-11 rounded-lg bg-amber-50/80 border border-amber-200/80 flex items-center justify-center text-amber-700 group-hover:scale-105 transition-all">
          <i data-lucide={item.icon} class="w-5 h-5"></i>
        </div>
        <span class="text-[11px] font-mono font-semibold px-2.5 py-0.5 rounded-full bg-slate-100 text-slate-700 border border-slate-200">
          {item.badge}
        </span>
      </div>

      <h4 class="text-slate-900 font-syne font-bold text-base mb-1 tracking-tight group-hover:text-blue-900 transition-colors">
        {item.authority}
      </h4>
      <p class="text-xs font-mono text-amber-800 font-semibold mb-2.5">
        {item.category}
      </p>
      <p class="text-xs text-slate-600 leading-relaxed">
        {item.scope}
      </p>

      <div class="mt-5 pt-3 border-t border-slate-100 flex items-center justify-between text-[11px]">
        <span class="flex items-center text-emerald-700 font-medium">
          <i data-lucide="check-circle" class="w-3.5 h-3.5 mr-1 text-emerald-600"></i> Standard Adherence
        </span>
        <span class="font-mono text-slate-500">Active Operational Benchmark</span>
      </div>
    </div>
  ))}
</div>
