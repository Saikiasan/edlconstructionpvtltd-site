---
---

<footer class="bg-slate-900 text-slate-300 border-t border-slate-800 text-sm">
  <!-- Top Emergency / Nodal Hotline Banner (Clean, Official) -->
  <div class="border-b border-slate-800 bg-slate-950">
    <div class="max-w-7xl mx-auto px-4 sm:px-8 py-4 flex flex-col md:flex-row items-center justify-between gap-4">
      <div class="flex items-center space-x-4">
        <div class="h-9 w-9 rounded-lg bg-amber-500/15 border border-amber-500/30 flex items-center justify-center text-amber-400 flex-shrink-0">
          <i data-lucide="phone-call" class="w-4 h-4"></i>
        </div>
        <div>
          <span class="text-xs font-mono uppercase tracking-wider text-amber-400 font-bold">Public Works & Infrastructure Nodal Desk</span>
          <p class="text-xs text-slate-300">Engineering and project liaison for highway, bridge, and civil projects</p>
        </div>
      </div>
      <div class="flex items-center space-x-3">
        <span class="text-xs font-mono text-slate-400">Direct Contact:</span>
        <a href="tel:8822494773" class="px-4 py-2 bg-slate-900 border border-amber-500/40 hover:border-amber-400 rounded-lg text-white font-mono font-bold text-xs tracking-wider transition-colors flex items-center text-amber-300">
          <i data-lucide="phone" class="w-3.5 h-3.5 mr-1.5 text-amber-400"></i>
          +91 8822494773
        </a>
      </div>
    </div>
  </div>

  <!-- Main Footer Content -->
  <div class="max-w-7xl mx-auto px-4 sm:px-8 py-12 lg:py-16">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-8 lg:gap-12">
      
      <!-- Brand & Accreditation Column -->
      <div class="lg:col-span-2 space-y-4">
        <div class="flex items-center space-x-3">
          <div class="h-10 w-10 rounded-lg bg-white p-1 border border-slate-700 flex items-center justify-center">
            <img src="/logo.jpeg" alt="EDL Logo" class="h-full w-full object-contain" />
          </div>
          <div>
            <h3 class="font-syne font-extrabold text-white text-base leading-tight">
              EDL CONSTRUCTION PVT LTD
            </h3>
            <p class="text-[11px] font-mono text-amber-400 uppercase tracking-wider">
              Public Sector Infrastructure & EPC Division
            </p>
          </div>
        </div>

        <p class="text-xs text-slate-400 leading-relaxed">
          Empanelled Class-1 (Super Special Category) Engineering, Procurement, and Construction (EPC) entity partnering with Central Ministries, State PWDs, NHAI, Metro Rail Corporations, and Municipal Authorities.
        </p>

        <div class="grid grid-cols-2 gap-2 pt-2 text-[11px] font-mono">
          <div class="p-2.5 rounded bg-slate-800/80 border border-slate-700">
            <span class="text-slate-400 block">Civil EPC Scope:</span>
            <strong class="text-slate-100">State & National Infrastructure</strong>
          </div>
          <div class="p-2.5 rounded bg-slate-800/80 border border-slate-700">
            <span class="text-slate-400 block">Quality Standard:</span>
            <strong class="text-amber-300">ISO 9001:2015 Regulated</strong>
          </div>
          <div class="p-2.5 rounded bg-slate-800/80 border border-slate-700">
            <span class="text-slate-400 block">Governance:</span>
            <strong class="text-emerald-400">Strict Statutory Adherence</strong>
          </div>
          <div class="p-2.5 rounded bg-slate-800/80 border border-slate-700">
            <span class="text-slate-400 block">Testing Protocol:</span>
            <strong class="text-slate-100">IS 456 & IRC Validated</strong>
          </div>
        </div>
      </div>

      <!-- Infrastructure Verticals -->
      <div class="space-y-3">
        <h4 class="text-xs font-mono font-bold uppercase tracking-wider text-white border-b border-slate-800 pb-2">
          Public Verticals
        </h4>
        <ul class="space-y-2 text-xs">
          <li><a href="/gov/infrastructure#highways" class="hover:text-amber-400 transition-colors">National Highways & Expressways</a></li>
          <li><a href="/gov/infrastructure#bridges" class="hover:text-amber-400 transition-colors">Bridges & Marine Corridors</a></li>
          <li><a href="/gov/infrastructure#transit" class="hover:text-amber-400 transition-colors">Metro & Rail Transit Viaducts</a></li>
          <li><a href="/gov/infrastructure#institutional" class="hover:text-amber-400 transition-colors">Administrative & Secretariats</a></li>
          <li><a href="/gov/infrastructure#water" class="hover:text-amber-400 transition-colors">Smart Water & ZLD Utilities</a></li>
          <li><a href="/gov/infrastructure#strategic" class="hover:text-amber-400 transition-colors">Strategic & Defense Works</a></li>
        </ul>
      </div>

      <!-- E-Tenders & Compliance -->
      <div class="space-y-3">
        <h4 class="text-xs font-mono font-bold uppercase tracking-wider text-white border-b border-slate-800 pb-2">
          Tenders & Compliance
        </h4>
        <ul class="space-y-2 text-xs">
          <li><a href="/gov/tenders" class="hover:text-amber-400 transition-colors">Active E-Tenders & RFPs</a></li>
          <li><a href="/gov/tenders#submit-eoi" class="hover:text-amber-400 transition-colors">Expression of Interest (EOI)</a></li>
          <li><a href="/gov/tenders#subcontractor-onboarding" class="hover:text-amber-400 transition-colors">MSME & Vendor Prequalification</a></li>
          <li><a href="/gov/compliance#cvc" class="hover:text-amber-400 transition-colors">CVC Transparency Charter</a></li>
          <li><a href="/gov/compliance#iso" class="hover:text-amber-400 transition-colors">ISO 9001 / 14001 / 45001</a></li>
          <li><a href="/gov/telemetry" class="hover:text-amber-400 transition-colors">Public Telemetry Dashboard</a></li>
        </ul>
      </div>

      <!-- Nodal Liaison & Protocol Desk -->
      <div class="space-y-3">
        <h4 class="text-xs font-mono font-bold uppercase tracking-wider text-white border-b border-slate-800 pb-2">
          Nodal Liaison Desk
        </h4>
        <div class="space-y-2 text-xs text-slate-400">
          <p class="flex items-start">
            <i data-lucide="map-pin" class="w-3.5 h-3.5 mr-2 text-amber-400 flex-shrink-0 mt-0.5"></i>
            <span><strong>Registered Office:</strong> EDL Constructions Pvt. Ltd., Sadiya, Tinsukia - 786157, Assam, India</span>
          </p>
          <p class="flex items-start">
            <i data-lucide="phone" class="w-3.5 h-3.5 mr-2 text-amber-400 flex-shrink-0 mt-0.5"></i>
            <span><strong>Technical / Nodal Desk:</strong> <a href="tel:8822494773" class="text-sky-300 font-mono hover:underline font-semibold">+91 8822494773</a></span>
          </p>
          <p class="flex items-start">
            <i data-lucide="mail" class="w-3.5 h-3.5 mr-2 text-amber-400 flex-shrink-0 mt-0.5"></i>
            <span><strong>Official Gov Desk:</strong> <a href="mailto:contact@edlconstructionpvtltd.in" class="hover:text-white font-mono text-slate-300">contact@edlconstructionpvtltd.in</a></span>
          </p>
          <p class="flex items-start">
            <i data-lucide="shield-alert" class="w-3.5 h-3.5 mr-2 text-emerald-400 flex-shrink-0 mt-0.5"></i>
            <span><strong>Vigilance / Compliance:</strong> <a href="mailto:support@edlconstructionpvtltd.in" class="hover:text-white font-mono text-slate-300">support@edlconstructionpvtltd.in</a></span>
          </p>
          <div class="pt-2">
            <a href="/gov/liaison" class="inline-flex items-center text-xs text-amber-400 hover:underline font-semibold">
              Access Full Nodal Directory <i data-lucide="arrow-right" class="w-3 h-3 ml-1"></i>
            </a>
          </div>
        </div>
      </div>

    </div>

    <!-- Bottom Statutory Legal Strip -->
    <div class="mt-12 pt-6 border-t border-slate-800 flex flex-col md:flex-row items-center justify-between text-xs text-slate-400 gap-4">
      <p>
        © 2026 EDL Construction Pvt Ltd — Government Infrastructure Division. All rights reserved.
      </p>
      <div class="flex items-center space-x-6">
        <a href="/gov/compliance" class="hover:text-slate-200 transition-colors">Statutory Standards</a>
        <a href="/gov/compliance#cvc" class="hover:text-slate-200 transition-colors">Integrity & Quality</a>
        <a href="/" class="text-amber-400 hover:underline">Corporate Main Site</a>
      </div>
    </div>
  </div>
</footer>
